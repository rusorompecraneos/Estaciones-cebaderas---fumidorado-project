<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FumiDorado — Acceso</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <style>
    .role-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--color-bg);
      padding: var(--space-6);
    }
    .role-card {
      width: 100%;
      max-width: 420px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-8);
    }
    .role-brand {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-4);
    }
    .role-brand__icon {
      width: 72px;
      height: 72px;
      background: var(--color-gold);
      border-radius: var(--radius-lg);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-weight: var(--weight-bold);
      font-size: var(--text-2xl);
      color: #111;
      box-shadow: var(--shadow-gold);
    }
    .role-brand__name {
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      font-weight: var(--weight-bold);
      color: var(--color-gold);
      text-align: center;
    }
    .role-brand__sub {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      text-align: center;
      margin: 0;
    }
    .role-section {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .role-section__label {
      font-size: var(--text-xs);
      font-family: var(--font-display);
      font-weight: var(--weight-semi);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text-faint);
      text-align: center;
    }
    .role-btn {
      width: 100%;
      display: flex;
      align-items: center;
      gap: var(--space-5);
      padding: var(--space-5) var(--space-6);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      cursor: pointer;
      text-decoration: none;
      transition: border-color var(--transition-base), box-shadow var(--transition-base), transform var(--transition-fast);
    }
    .role-btn:hover {
      border-color: var(--color-gold);
      box-shadow: var(--shadow-gold);
      transform: translateY(-2px);
    }
    .role-btn:active { transform: scale(0.98); }
    .role-btn__icon {
      width: 48px;
      height: 48px;
      flex-shrink: 0;
      background: var(--color-gold-muted);
      border: 1px solid var(--color-border-gold);
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-gold);
      transition: background var(--transition-base);
    }
    .role-btn:hover .role-btn__icon { background: rgba(212,168,30,0.22); }
    .role-btn__info {
      display: flex;
      flex-direction: column;
      gap: 3px;
      text-align: left;
    }
    .role-btn__name {
      font-family: var(--font-display);
      font-size: var(--text-md);
      font-weight: var(--weight-semi);
      color: var(--color-text);
    }
    .role-btn__desc {
      font-size: var(--text-xs);
      color: var(--color-text-muted);
    }
    .role-btn__arrow {
      margin-left: auto;
      color: var(--color-text-faint);
      flex-shrink: 0;
      transition: color var(--transition-fast), transform var(--transition-fast);
    }
    .role-btn:hover .role-btn__arrow {
      color: var(--color-gold);
      transform: translateX(3px);
    }
    .role-footer {
      font-size: var(--text-xs);
      color: var(--color-text-faint);
      text-align: center;
    }
  </style>
</head>
<body>

<main class="role-page">
  <div class="role-card">

    <div class="role-brand">
      <div class="role-brand__icon">FD</div>
      <h1 class="role-brand__name">Fumi Dorado S.A.S</h1>
      <p class="role-brand__sub">Sistema de gestión de servicios</p>
    </div>

    <div class="role-section">
      <span class="role-section__label">¿Cómo desea ingresar?</span>

      <a href="/auth/login" class="role-btn">
        <div class="role-btn__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M12 2a5 5 0 1 0 0 10A5 5 0 0 0 12 2z"/>
            <path d="M12 14c-7 0-7 3-7 3v1h14v-1s0-3-7-3z"/>
            <polyline points="17 8 19 10 23 6" stroke-width="1.8"/>
          </svg>
        </div>
        <div class="role-btn__info">
          <span class="role-btn__name">Administrador</span>
          <span class="role-btn__desc">Acceso con usuario y contraseña</span>
        </div>
        <svg class="role-btn__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>

      <a href="/auth/tecnico" class="role-btn">
        <div class="role-btn__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/>
            <path d="M15.54 8.46a5 5 0 0 1 0 7.07M8.46 8.46a5 5 0 0 0 0 7.07"/>
          </svg>
        </div>
        <div class="role-btn__info">
          <span class="role-btn__name">Técnico</span>
          <span class="role-btn__desc">Acceso con código personal de 4 dígitos</span>
        </div>
        <svg class="role-btn__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>
    </div>

    <p class="role-footer">© <%= new Date().getFullYear() %> FumiDorado S.A.S. · Todos los derechos reservados.</p>

  </div>
</main>

</body>
</html>
