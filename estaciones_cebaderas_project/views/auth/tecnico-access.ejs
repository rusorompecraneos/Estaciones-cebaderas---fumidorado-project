<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FumiDorado — Acceso Técnico</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <style>
    .login-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--color-bg);
      padding: var(--space-6);
    }

    .login-back {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-muted);
      font-size: var(--text-sm);
      text-decoration: none;
      margin-bottom: var(--space-6);
      transition: color var(--transition-fast);
    }
    .login-back:hover { color: var(--color-gold); }

    .login-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-6);
    }
    .login-header__icon {
      width: 64px;
      height: 64px;
      background: var(--color-gold);
      border-radius: var(--radius-lg);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-weight: var(--weight-bold);
      font-size: var(--text-xl);
      color: #111;
      box-shadow: var(--shadow-gold);
    }
    .login-header__title {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      font-weight: var(--weight-bold);
      color: var(--color-gold);
      text-align: center;
    }
    .login-header__sub {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      text-align: center;
      margin: 0;
    }

    .login-role-badge {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-4);
      background: rgba(79,163,224,0.12);
      border: 1px solid rgba(79,163,224,0.3);
      border-radius: var(--radius-full);
      font-size: var(--text-xs);
      font-family: var(--font-display);
      font-weight: var(--weight-semi);
      color: var(--color-info);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: var(--space-6);
    }

    .field-error {
      font-size: var(--text-xs);
      color: var(--color-error);
      min-height: 16px;
      margin-top: 2px;
    }

    .form-control.is-error {
      border-color: var(--color-error);
      box-shadow: 0 0 0 3px rgba(224,82,82,0.15);
    }

    /* ── MODAL PIN ─────────────────────────────────────────── */
    .pin-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.75);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: var(--space-6);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition-base);
    }

    .pin-overlay.active {
      opacity: 1;
      pointer-events: all;
    }

    .pin-modal {
      width: 100%;
      max-width: 360px;
      background: var(--color-surface);
      border: 1px solid var(--color-border-gold);
      border-radius: var(--radius-xl);
      padding: var(--space-8) var(--space-6);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-6);
      transform: translateY(16px);
      transition: transform var(--transition-base);
      box-shadow: var(--shadow-lg), var(--shadow-gold);
    }

    .pin-overlay.active .pin-modal {
      transform: translateY(0);
    }

    .pin-modal__avatar {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: var(--color-gold);
      color: #111;
      font-family: var(--font-display);
      font-weight: var(--weight-bold);
      font-size: var(--text-lg);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .pin-modal__title {
      font-family: var(--font-display);
      font-size: var(--text-lg);
      font-weight: var(--weight-semi);
      text-align: center;
      color: var(--color-text);
    }

    .pin-modal__sub {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      text-align: center;
      margin: -16px 0 0 0;
    }

    /* Inputs PIN */
    .pin-inputs {
      display: flex;
      gap: var(--space-3);
    }

    .pin-digit {
      width: 56px;
      height: 64px;
      background: var(--color-surface-2);
      border: 1.5px solid var(--color-border);
      border-radius: var(--radius-md);
      color: var(--color-text);
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      font-weight: var(--weight-bold);
      text-align: center;
      outline: none;
      transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
      caret-color: var(--color-gold);
    }

    .pin-digit:focus {
      border-color: var(--color-gold);
      box-shadow: 0 0 0 3px var(--color-gold-glow);
    }

    .pin-digit.filled {
      border-color: var(--color-border-gold);
      background: var(--color-gold-muted);
    }

    .pin-digit.error {
      border-color: var(--color-error);
      box-shadow: 0 0 0 3px rgba(224,82,82,0.15);
      animation: shake 0.35s ease;
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20%       { transform: translateX(-6px); }
      40%       { transform: translateX(6px); }
      60%       { transform: translateX(-4px); }
      80%       { transform: translateX(4px); }
    }

    .pin-error {
      font-size: var(--text-xs);
      color: var(--color-error);
      text-align: center;
      min-height: 16px;
    }

    .pin-modal__actions {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      width: 100%;
    }

    .btn-spinner {
      width: 16px;
      height: 16px;
      border: 2px solid rgba(17,17,16,0.3);
      border-top-color: #111;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      flex-shrink: 0;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    .pin-cancel {
      background: none;
      border: none;
      color: var(--color-text-muted);
      font-size: var(--text-sm);
      cursor: pointer;
      text-align: center;
      padding: var(--space-2);
      transition: color var(--transition-fast);
    }
    .pin-cancel:hover { color: var(--color-text); }
  </style>
</head>
<body>

<main class="login-page">
  <div class="auth-card">

    <!-- Volver -->
    <a href="/auth/role-select" class="login-back">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
      Volver
    </a>

    <!-- Encabezado -->
    <div class="login-header">
      <div class="login-header__icon">FD</div>
      <h1 class="login-header__title">Fumi Dorado S.A.S</h1>
      <p class="login-header__sub">Sistema de gestión de servicios</p>
    </div>

    <!-- Badge rol -->
    <div class="login-role-badge">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="3"/>
        <path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/>
      </svg>
      Técnico
    </div>

    <!-- Alerta error global (flash) -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert--error" style="margin-bottom: var(--space-5);" role="alert">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <%= error %>
      </div>
    <% } %>

    <!-- Selector de técnico -->
    <div class="auth-card__form">
      <div class="form-group">
        <label class="form-label" for="tecnico-select">Seleccione su nombre</label>
        <div class="form-input-wrapper">
          <span class="input-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </span>
          <select
            class="form-control form-control--icon"
            id="tecnico-select"
            aria-label="Seleccionar técnico"
          >
            <option value="" disabled selected>— Seleccione un técnico —</option>
            <% tecnicos.forEach(function(t) { %>
              <option value="<%= t.id %>" data-nombre="<%= t.nombre %>" data-iniciales="<%= t.iniciales %>">
                <%= t.nombre %>
              </option>
            <% }); %>
          </select>
        </div>
        <span class="field-error" id="select-error" role="alert"></span>
      </div>

      <button
        class="btn btn--primary btn--lg"
        type="button"
        id="btn-continuar"
        style="margin-top: var(--space-4);"
      >
        Continuar
      </button>
    </div>

  </div>
</main>

<!-- ── MODAL PIN ──────────────────────────────────────────────────────────── -->
<div class="pin-overlay" id="pin-overlay" role="dialog" aria-modal="true" aria-labelledby="pin-title">
  <div class="pin-modal">

    <!-- Avatar con iniciales del técnico -->
    <div class="pin-modal__avatar" id="pin-avatar">—</div>

    <div style="text-align:center; display:flex; flex-direction:column; gap: 6px;">
      <h2 class="pin-modal__title" id="pin-title">Ingrese su PIN</h2>
      <p class="pin-modal__sub" id="pin-nombre"></p>
    </div>

    <!-- Inputs de 4 dígitos -->
    <div class="pin-inputs" id="pin-inputs">
      <input class="pin-digit" type="password" inputmode="numeric" maxlength="1" data-index="0" aria-label="Dígito 1"/>
      <input class="pin-digit" type="password" inputmode="numeric" maxlength="1" data-index="1" aria-label="Dígito 2"/>
      <input class="pin-digit" type="password" inputmode="numeric" maxlength="1" data-index="2" aria-label="Dígito 3"/>
      <input class="pin-digit" type="password" inputmode="numeric" maxlength="1" data-index="3" aria-label="Dígito 4"/>
    </div>

    <span class="pin-error" id="pin-error" role="alert"></span>

    <div class="pin-modal__actions">
      <button class="btn btn--primary btn--lg" type="button" id="btn-verificar">
        <span id="pin-btn-text">Verificar PIN</span>
        <span id="pin-spinner" class="btn-spinner hidden"></span>
      </button>
      <button class="pin-cancel" type="button" id="btn-cancelar-pin">Cancelar</button>
    </div>

  </div>
</div>

<script>
(function () {
  'use strict';

  // ── Referencias ──────────────────────────────────────────────────────────
  const selectEl     = document.getElementById('tecnico-select');
  const selectErr    = document.getElementById('select-error');
  const btnContinuar = document.getElementById('btn-continuar');

  const pinOverlay   = document.getElementById('pin-overlay');
  const pinAvatar    = document.getElementById('pin-avatar');
  const pinNombre    = document.getElementById('pin-nombre');
  const pinDigits    = Array.from(document.querySelectorAll('.pin-digit'));
  const pinError     = document.getElementById('pin-error');
  const btnVerificar = document.getElementById('btn-verificar');
  const pinBtnText   = document.getElementById('pin-btn-text');
  const pinSpinner   = document.getElementById('pin-spinner');
  const btnCancelar  = document.getElementById('btn-cancelar-pin');

  // ── Abrir modal ──────────────────────────────────────────────────────────
  btnContinuar.addEventListener('click', function () {
    const opt = selectEl.options[selectEl.selectedIndex];

    if (!selectEl.value) {
      selectErr.textContent = 'Seleccione un técnico para continuar.';
      selectEl.classList.add('is-error');
      return;
    }

    selectErr.textContent = '';
    selectEl.classList.remove('is-error');

    // Poblar modal
    pinAvatar.textContent = opt.dataset.iniciales || '?';
    pinNombre.textContent  = opt.dataset.nombre    || '';

    // Limpiar dígitos
    pinDigits.forEach(d => {
      d.value = '';
      d.classList.remove('filled', 'error');
    });
    pinError.textContent = '';

    // Mostrar overlay
    pinOverlay.classList.add('active');
    setTimeout(() => pinDigits[0].focus(), 120);
  });

  // ── Cerrar modal ─────────────────────────────────────────────────────────
  btnCancelar.addEventListener('click', closeModal);

  pinOverlay.addEventListener('click', function (e) {
    if (e.target === pinOverlay) closeModal();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeModal();
  });

  function closeModal() {
    pinOverlay.classList.remove('active');
    pinDigits.forEach(d => {
      d.value = '';
      d.classList.remove('filled', 'error');
    });
    pinError.textContent = '';
    resetBtn();
  }

  // ── Lógica de inputs PIN ─────────────────────────────────────────────────
  pinDigits.forEach(function (digit, idx) {
    digit.addEventListener('keydown', function (e) {
      // Solo números
      if (!/^\d$/.test(e.key) && !['Backspace', 'ArrowLeft', 'ArrowRight', 'Tab'].includes(e.key)) {
        e.preventDefault();
      }
    });

    digit.addEventListener('input', function () {
      // Limpiar error al escribir
      pinDigits.forEach(d => d.classList.remove('error'));
      pinError.textContent = '';

      // Solo dígito
      this.value = this.value.replace(/\D/g, '').slice(-1);

      if (this.value) {
        this.classList.add('filled');
        // Avanzar al siguiente
        if (idx < 3) pinDigits[idx + 1].focus();
        // Si es el último, disparar verificación automática
        if (idx === 3) verificarPin();
      } else {
        this.classList.remove('filled');
      }
    });

    digit.addEventListener('keydown', function (e) {
      if (e.key === 'Backspace' && !this.value && idx > 0) {
        pinDigits[idx - 1].focus();
        pinDigits[idx - 1].value = '';
        pinDigits[idx - 1].classList.remove('filled');
      }
    });

    // Pegar
    digit.addEventListener('paste', function (e) {
      e.preventDefault();
      const pasted = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 4);
      pasted.split('').forEach(function (char, i) {
        if (pinDigits[i]) {
          pinDigits[i].value = char;
          pinDigits[i].classList.add('filled');
        }
      });
      const next = Math.min(pasted.length, 3);
      pinDigits[next].focus();
      if (pasted.length === 4) verificarPin();
    });
  });

  // ── Verificar PIN ────────────────────────────────────────────────────────
  btnVerificar.addEventListener('click', verificarPin);

  function verificarPin() {
    const pin = pinDigits.map(d => d.value).join('');

    if (pin.length < 4) {
      showPinError('Ingrese los 4 dígitos del PIN.');
      return;
    }

    // Simular loading
    btnVerificar.disabled = true;
    pinBtnText.textContent = 'Verificando...';
    pinSpinner.classList.remove('hidden');

    // TODO: reemplazar por fetch a /auth/tecnico/verify cuando conectes la DB
    setTimeout(function () {
      const tecnicoId = selectEl.value;

      // ── MOCK: PIN correcto si coincide con el mock del servidor ──────────
      // Los PINs mock están definidos en authService.js (MOCK_TECNICOS)
      // Aquí simulamos que siempre falla para que el técnico vea el flujo.
      // Cuando conectes la DB, este bloque se reemplaza por fetch POST.

      fetch('/auth/tecnico/verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tecnicoId: tecnicoId, pin: pin })
      })
      .then(function (res) { return res.json(); })
      .then(function (data) {
        if (data.success) {
          // Redirigir al dashboard (próxima iteración)
          window.location.href = data.redirect || '/tecnico/dashboard';
        } else {
          showPinError(data.message || 'PIN incorrecto. Intente nuevamente.');
          resetBtn();
        }
      })
      .catch(function () {
        showPinError('Error de conexión. Intente nuevamente.');
        resetBtn();
      });

    }, 500);
  }

  function showPinError(msg) {
    pinError.textContent = msg;
    pinDigits.forEach(d => d.classList.add('error'));
    // Limpiar y volver al primero
    pinDigits.forEach(d => { d.value = ''; d.classList.remove('filled'); });
    pinDigits[0].focus();
  }

  function resetBtn() {
    btnVerificar.disabled = false;
    pinBtnText.textContent = 'Verificar PIN';
    pinSpinner.classList.add('hidden');
  }

})();
</script>

</body>
</html>
