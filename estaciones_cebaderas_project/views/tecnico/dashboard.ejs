<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css"/>
  <style>
    .dashboard-page {
      min-height: 100vh;
      background: var(--color-bg);
      display: flex;
      flex-direction: column;
    }

    /* ── Topbar ── */
    .dash-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: var(--space-4) var(--space-8);
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .dash-topbar__brand { display: flex; align-items: center; gap: var(--space-3); }
    .dash-topbar__logo {
      width: 38px; height: 38px;
      background: var(--color-gold);
      border-radius: var(--radius-md);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-display);
      font-weight: var(--weight-bold);
      font-size: var(--text-sm);
      color: #111;
    }
    .dash-topbar__name { font-family: var(--font-display); font-size: var(--text-md); font-weight: var(--weight-semi); color: var(--color-text); line-height: 1.2; }
    .dash-topbar__sub  { font-size: var(--text-xs); color: var(--color-text-muted); }
    .dash-topbar__right { display: flex; align-items: center; gap: var(--space-4); }
    .dash-topbar__user  { display: flex; align-items: center; gap: var(--space-3); }
    .dash-topbar__avatar {
      width: 36px; height: 36px; border-radius: 50%;
      background: var(--color-info);
      color: #fff;
      font-family: var(--font-display); font-weight: var(--weight-bold);
      font-size: var(--text-xs);
      display: flex; align-items: center; justify-content: center;
    }
    .dash-topbar__username { font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--color-text); line-height: 1.2; }
    .dash-topbar__role     { font-size: var(--text-xs); color: var(--color-info); }
    .dash-topbar__logout {
      display: flex; align-items: center; gap: var(--space-2);
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-md);
      border: 1px solid var(--color-border);
      background: transparent;
      color: var(--color-text-muted); font-size: var(--text-xs);
      font-family: var(--font-display); font-weight: var(--weight-medium);
      cursor: pointer; text-decoration: none;
      transition: all var(--transition-fast);
    }
    .dash-topbar__logout:hover { border-color: var(--color-error); color: var(--color-error); }

    /* ── Contenido ── */
    .dash-content {
      flex: 1;
      max-width: 560px;
      width: 100%;
      margin: 0 auto;
      padding: var(--space-12) var(--space-8);
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }

    /* ── Bienvenida ── */
    .dash-welcome__greeting { font-size: var(--text-sm); color: var(--color-text-muted); }
    .dash-welcome__title {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      font-weight: var(--weight-bold);
      color: var(--color-text); line-height: 1.15;
      margin-top: var(--space-2);
    }
    .dash-welcome__sub { font-size: var(--text-sm); color: var(--color-text-muted); margin: var(--space-2) 0 0 0; }

    /* ── Card de formulario ── */
    .visita-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: var(--space-8);
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    .visita-card__title {
      font-family: var(--font-display);
      font-size: var(--text-lg);
      font-weight: var(--weight-semi);
      color: var(--color-text);
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--color-border);
    }

    /* Select custom con ícono */
    .form-input-wrapper { position: relative; }
    .input-icon {
      position: absolute; left: var(--space-3); top: 50%;
      transform: translateY(-50%);
      color: var(--color-text-faint);
      pointer-events: none; font-size: 16px;
      display: flex; align-items: center;
    }

    /* Flecha animada del select de sedes */
    #sedes-wrapper {
      transition: opacity var(--transition-base);
    }
    #sedes-wrapper.loading { opacity: 0.5; pointer-events: none; }

    /* Spinner inline */
    .select-spinner {
      position: absolute; right: var(--space-8); top: 50%;
      transform: translateY(-50%);
      width: 14px; height: 14px;
      border: 2px solid var(--color-border);
      border-top-color: var(--color-gold);
      border-radius: 50%;
      animation: spin .7s linear infinite;
      display: none;
    }
    .select-spinner.visible { display: block; }
    @keyframes spin { to { transform: translateY(-50%) rotate(360deg); } }

    /* Badge rol técnico */
    .role-pill {
      display: inline-flex; align-items: center; gap: var(--space-2);
      padding: var(--space-1) var(--space-3);
      background: rgba(79,163,224,0.12);
      border: 1px solid rgba(79,163,224,0.3);
      border-radius: var(--radius-full);
      font-size: var(--text-xs);
      font-family: var(--font-display); font-weight: var(--weight-semi);
      color: var(--color-info);
    }

    @media (max-width: 640px) {
      .dash-content { padding: var(--space-6) var(--space-4); }
      .dash-topbar  { padding: var(--space-4); }
      .dash-topbar__username, .dash-topbar__role { display: none; }
    }
  </style>
</head>
<body>

<div class="dashboard-page">

  <!-- Topbar -->
  <header class="dash-topbar">
    <div class="dash-topbar__brand">
      <div class="dash-topbar__logo">FD</div>
      <div>
        <div class="dash-topbar__name">Fumi Dorado S.A.S</div>
        <div class="dash-topbar__sub">Sistema de gestión de servicios</div>
      </div>
    </div>
    <div class="dash-topbar__right">
      <div class="dash-topbar__user">
        <div class="dash-topbar__avatar">
          <%= currentUser.iniciales || currentUser.nombre.split(' ').map(n=>n[0]).join('').slice(0,2).toUpperCase() %>
        </div>
        <div>
          <div class="dash-topbar__username"><%= currentUser.nombre %></div>
          <div class="dash-topbar__role">Técnico</div>
        </div>
      </div>
      <a href="/auth/logout" class="dash-topbar__logout">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <polyline points="16 17 21 12 16 7"/>
          <line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
        Salir
      </a>
    </div>
  </header>

  <!-- Contenido -->
  <main class="dash-content">

    <div>
      <span class="dash-welcome__greeting">
        <%= new Date().getHours() < 12 ? 'Buenos días' : new Date().getHours() < 18 ? 'Buenas tardes' : 'Buenas noches' %>,
      </span>
      <h1 class="dash-welcome__title"><%= currentUser.nombre.split(' ')[0] %> 👷</h1>
      <p class="dash-welcome__sub">Selecciona el cliente y la sede donde realizarás la visita de hoy.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert--error" role="alert">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <%= error %>
      </div>
    <% } %>

    <div class="visita-card">
      <h2 class="visita-card__title">
        <span>📍</span> &nbsp;Nueva visita
      </h2>

      <form action="/tecnico/visita/iniciar" method="POST" id="visita-form">

        <!-- Cliente -->
        <div class="form-group">
          <label class="form-label" for="clienteId">Cliente</label>
          <div class="form-input-wrapper">
            <span class="input-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="7" width="20" height="14" rx="2"/>
                <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
              </svg>
            </span>
            <select class="form-control form-control--icon" id="clienteId" name="clienteId" required>
              <option value="" disabled selected>— Seleccione un cliente —</option>
              <% clientes.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.codigo %> — <%= c.nombre %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <!-- Sede (se carga por AJAX) -->
        <div class="form-group mt-4" id="sedes-wrapper" style="display:none;">
          <label class="form-label" for="sedeId">Sede</label>
          <div class="form-input-wrapper">
            <span class="input-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </span>
            <select class="form-control form-control--icon" id="sedeId" name="sedeId" required>
              <option value="" disabled selected>— Seleccione una sede —</option>
            </select>
            <div class="select-spinner" id="sede-spinner"></div>
          </div>
        </div>

        <button class="btn btn--primary btn--lg" type="submit" id="submit-btn"
                style="margin-top: var(--space-6);" disabled>
          Iniciar visita →
        </button>

      </form>
    </div>

  </main>

</div>

<script>
(function () {
  const clienteSelect = document.getElementById('clienteId');
  const sedeWrapper   = document.getElementById('sedes-wrapper');
  const sedeSelect    = document.getElementById('sedeId');
  const spinner       = document.getElementById('sede-spinner');
  const submitBtn     = document.getElementById('submit-btn');

  clienteSelect.addEventListener('change', async function () {
    const clienteId = this.value;
    if (!clienteId) return;

    // Mostrar sección sede y spinner
    sedeWrapper.style.display = 'block';
    spinner.classList.add('visible');
    sedeSelect.innerHTML = '<option value="" disabled selected>Cargando sedes...</option>';
    submitBtn.disabled = true;

    try {
      const res  = await fetch(`/tecnico/sedes/${clienteId}`);
      const data = await res.json();

      sedeSelect.innerHTML = '<option value="" disabled selected>— Seleccione una sede —</option>';
      if (data.success && data.sedes.length > 0) {
        data.sedes.forEach(s => {
          const opt = document.createElement('option');
          opt.value       = s.id;
          opt.textContent = `${s.codigo} — ${s.nombre}`;
          sedeSelect.appendChild(opt);
        });
      } else {
        sedeSelect.innerHTML = '<option value="" disabled selected>Sin sedes disponibles</option>';
      }
    } catch {
      sedeSelect.innerHTML = '<option value="" disabled selected>Error cargando sedes</option>';
    } finally {
      spinner.classList.remove('visible');
    }
  });

  sedeSelect.addEventListener('change', function () {
    submitBtn.disabled = !this.value;
  });
})();
</script>

</body>
</html>
