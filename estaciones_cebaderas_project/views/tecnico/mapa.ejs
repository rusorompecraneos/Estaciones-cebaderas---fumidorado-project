<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Mapa UPC — <%= visita.sede_nombre %></title>
  <link rel="stylesheet" href="/css/styles.css"/>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <style>
    * { box-sizing:border-box; margin:0; padding:0; }
    body { background:var(--color-bg); color:var(--color-text); font-family:var(--font-body); min-height:100vh; display:flex; flex-direction:column; }

    /* ── Topbar ── */
    .topbar {
      display:flex; align-items:center; justify-content:space-between;
      padding:var(--space-4) var(--space-6);
      background:var(--color-surface); border-bottom:1px solid var(--color-border);
      position:sticky; top:0; z-index:100; flex-shrink:0;
    }
    .topbar__left  { display:flex; align-items:center; gap:var(--space-4); }
    .topbar__back  { display:flex; align-items:center; gap:var(--space-2); color:var(--color-text-muted); text-decoration:none; transition:color var(--transition-fast); }
    .topbar__back:hover { color:var(--color-gold); }
    .topbar__title { font-family:var(--font-display); font-size:var(--text-md); font-weight:var(--weight-semi); }
    .topbar__sub   { font-size:var(--text-xs); color:var(--color-text-muted); }

    /* ── Layout ── */
    .layout { flex:1; display:flex; overflow:hidden; height:calc(100vh - 64px); }

    /* ── Panel izquierdo — mini lista ── */
    .mini-list {
      width:220px; flex-shrink:0;
      background:var(--color-surface); border-right:1px solid var(--color-border);
      overflow-y:auto; padding:var(--space-4);
      display:flex; flex-direction:column; gap:var(--space-2);
    }
    .mini-list__title {
      font-family:var(--font-display); font-size:var(--text-xs);
      font-weight:var(--weight-semi); letter-spacing:.08em;
      text-transform:uppercase; color:var(--color-text-faint);
      margin-bottom:var(--space-2);
    }
    .mini-item {
      display:flex; align-items:center; gap:var(--space-2);
      padding:var(--space-2) var(--space-3);
      border-radius:var(--radius-md);
      border:1px solid var(--color-border);
      background:var(--color-surface-2);
      cursor:pointer;
      transition:border-color var(--transition-fast), background var(--transition-fast);
      font-size:var(--text-xs);
    }
    .mini-item:hover     { border-color:var(--color-gold); background:var(--color-gold-muted); }
    .mini-item.highlight { border-color:var(--color-gold); background:var(--color-gold-muted); }
    .mini-dot {
      width:10px; height:10px; border-radius:50%; flex-shrink:0;
    }
    .mini-num  { font-weight:var(--weight-semi); color:var(--color-text); }
    .mini-tipo { color:var(--color-text-muted); flex:1; }

    /* ── Área del mapa ── */
    .map-area {
      flex:1; overflow:auto;
      background:#1a1a18;
      display:flex; align-items:flex-start; justify-content:center;
      padding:var(--space-6);
    }
    .map-wrap {
      position:relative;
      display:inline-block;
      box-shadow:var(--shadow-lg);
    }
    #pdf-canvas { display:block; }

    /* Puntos interactivos */
    .mapa-punto {
      position:absolute;
      width:30px; height:30px;
      border-radius:50%;
      border:2.5px solid white;
      display:flex; align-items:center; justify-content:center;
      font-size:11px; font-weight:700; color:white;
      transform:translate(-50%, -50%);
      cursor:pointer;
      user-select:none;
      box-shadow:0 2px 8px rgba(0,0,0,.4);
      transition:box-shadow .15s, transform .15s;
      z-index:10;
    }
    .mapa-punto:hover    { transform:translate(-50%,-50%) scale(1.18); box-shadow:0 0 0 4px rgba(255,255,255,.2); }
    .mapa-punto.pendiente   { background:#555450; }
    .mapa-punto.sin_consumo { background:#3B9B5C; }
    .mapa-punto.con_consumo { background:#D94F4F; }
    .mapa-punto.captura     { background:#E09B35; }
    .mapa-punto.highlight   { box-shadow:0 0 0 5px rgba(240,200,48,.7); }

    /* Tooltip del punto */
    .punto-tooltip {
      position:absolute;
      background:var(--color-surface);
      border:1px solid var(--color-border-gold);
      border-radius:var(--radius-md);
      padding:var(--space-3) var(--space-4);
      min-width:160px;
      box-shadow:var(--shadow-md);
      z-index:50;
      pointer-events:none;
      display:none;
    }
    .punto-tooltip.visible { display:block; }
    .tooltip-title { font-family:var(--font-display); font-size:var(--text-sm); font-weight:var(--weight-semi); margin-bottom:var(--space-2); }
    .tooltip-btns  { display:flex; flex-direction:column; gap:var(--space-1); pointer-events:all; }
    .tooltip-btn {
      padding:var(--space-2) var(--space-3);
      border-radius:var(--radius-sm);
      border:1px solid var(--color-border);
      background:var(--color-surface-2);
      color:var(--color-text-muted);
      font-size:var(--text-xs); cursor:pointer;
      display:flex; align-items:center; gap:var(--space-2);
      transition:all var(--transition-fast);
    }
    .tooltip-btn:hover { border-color:var(--color-gold); color:var(--color-text); }
    .tooltip-btn .dot  { width:8px; height:8px; border-radius:50%; }
    .dot-sc  { background:#3B9B5C; }
    .dot-cc  { background:#D94F4F; }
    .dot-cap { background:#E09B35; }

    /* ── Leyenda ── */
    .leyenda {
      position:absolute; bottom:var(--space-4); right:var(--space-4);
      background:rgba(17,17,16,.85); backdrop-filter:blur(8px);
      border:1px solid var(--color-border);
      border-radius:var(--radius-lg);
      padding:var(--space-3) var(--space-4);
      display:flex; flex-direction:column; gap:var(--space-2);
      z-index:30;
    }
    .leyenda-item { display:flex; align-items:center; gap:var(--space-2); font-size:11px; color:var(--color-text-muted); }
    .leyenda-dot  { width:8px; height:8px; border-radius:50%; flex-shrink:0; }

    /* PDF loading */
    .pdf-loading {
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      gap:var(--space-4); padding:var(--space-12);
      color:var(--color-text-muted); font-size:var(--text-sm);
    }
    .pdf-spinner { width:32px; height:32px; border:3px solid var(--color-border); border-top-color:var(--color-gold); border-radius:50%; animation:spin .8s linear infinite; }
    @keyframes spin { to { transform:rotate(360deg); } }

    /* Sin diagrama */
    .no-diagrama {
      flex:1; display:flex; flex-direction:column;
      align-items:center; justify-content:center;
      gap:var(--space-4); color:var(--color-text-muted); text-align:center;
    }
    .no-diagrama__icon { font-size:3rem; }
    .no-diagrama__title { font-family:var(--font-display); font-size:var(--text-lg); color:var(--color-text); }
    .no-diagrama__desc { font-size:var(--text-sm); max-width:360px; }

    /* ── Responsive móvil ── */
  .mini-toggle {
    display: none;
    background: var(--color-surface);
    border: none;
    color: var(--color-text-muted);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-xs);
    cursor: pointer;
    border-bottom: 1px solid var(--color-border);
    width: 100%;
    text-align: left;
    gap: var(--space-2);
    align-items: center;
  }
  @media (max-width: 768px) {
    .mini-list    { display: none; width: 100%; max-height: 160px; border-right: none; border-bottom: 1px solid var(--color-border); }
    .mini-list.open { display: flex; }
    .mini-toggle  { display: flex; }
    .layout       { flex-direction: column; height: auto; }
    .map-area     { min-height: 60vh; }
    .topbar__title { font-size: var(--text-sm); }
  }
  </style>
</head>
<body>

<header class="topbar">
  <div class="topbar__left">
    <a href="/tecnico/visita/<%= visita.id %>" class="topbar__back">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </a>

    <div>
      <div class="topbar__title">Mapa UPC</div>

      <div class="topbar__sub">
        <%= visita.cliente_codigo %> — <%= visita.cliente_nombre %>
        &nbsp;·&nbsp;
        Sede <%= visita.sede_codigo %>
      </div>
    </div>
  </div>

  <div style="display:flex;gap:var(--space-3);">
    <a href="/tecnico/visita/<%= visita.id %>/reporte"
       class="btn btn--primary btn--sm"
       style="display:flex;align-items:center;gap:var(--space-2);">

      <svg width="14"
           height="14"
           viewBox="0 0 24 24"
           fill="none"
           stroke="currentColor"
           stroke-width="2">
        <polyline points="6 9 6 2 18 2 18 9"/>
        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
        <rect x="6" y="14" width="12" height="8"/>
      </svg>

      Generar reporte
    </a>
  </div>
</header>

<% if (!diagrama) { %>
  <!-- Sin diagrama configurado -->
  <div class="no-diagrama">
    <div class="no-diagrama__icon">🗺️</div>
    <div class="no-diagrama__title">Sin diagrama configurado</div>
    <p class="no-diagrama__desc">
      El administrador aún no ha subido el diagrama UPC para esta sede.
      Cuando lo configure, aparecerá aquí con todos los puntos interactivos.
    </p>
    <a href="/tecnico/visita/<%= visita.id %>" class="btn btn--secondary">
      Volver a la visita
    </a>
  </div>

<% } else { %>

  <button class="mini-toggle" id="mini-toggle" type="button">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/>
      <line x1="8" y1="18" x2="21" y2="18"/>
      <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/>
      <line x1="3" y1="18" x2="3.01" y2="18"/>
    </svg>
    Ver estaciones (<%= estaciones.length %>)
  </button>

  <div class="layout">

    <!-- Mini lista lateral -->
    <aside class="mini-list">
      <div class="mini-list__title">Estaciones (<%= estaciones.length %>)</div>
      <% estaciones.forEach(est => { %>
        <div class="mini-item" id="mini-<%= est.id %>"
             onclick="highlightPunto(<%= est.numero %>)">
          <div class="mini-dot <%= est.consumo || 'pendiente' %>"
               style="background:<%= est.consumo === 'sin_consumo' ? '#3B9B5C' : est.consumo === 'con_consumo' ? '#D94F4F' : est.consumo === 'captura' ? '#E09B35' : '#555450' %>">
          </div>
          <span class="mini-num">E<%= est.numero %></span>
          <span class="mini-tipo">
            <%= est.tipo === 'quimica' ? 'Química' : est.tipo === 'mecanica' ? 'Mecánica' : 'Ecológica' %>
          </span>
        </div>
      <% }) %>
    </aside>

    <!-- Mapa -->

    <div class="map-area" style="flex-direction:column; align-items:stretch; padding:0;">
      <!-- Controles de página -->
      <div id="page-controls" style="
        display:none; align-items:center; justify-content:center;
        gap:var(--space-4); padding:var(--space-3) var(--space-6);
        background:var(--color-surface); border-bottom:1px solid var(--color-border);
        flex-shrink:0;">
        <button id="btn-prev-page" class="btn btn--ghost btn--sm" type="button" disabled>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
          Anterior
        </button>
        <span id="page-info" style="font-size:var(--text-sm);color:var(--color-text-muted);">
          Página 1 de 1
        </span>
        <button id="btn-next-page" class="btn btn--ghost btn--sm" type="button">
          Siguiente
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </button>
      </div>
      <!-- Área scrollable del mapa -->
      <div style="flex:1;overflow:auto;background:#1a1a18;display:flex;align-items:flex-start;justify-content:center;padding:var(--space-6);">
        <div class="map-wrap" id="map-wrap" style="position:relative; line-height:0;">
          <div class="pdf-loading" id="pdf-loading">
            <div class="pdf-spinner"></div>
            <span>Cargando diagrama...</span>
          </div>
          <div id="pages-container" style="display:flex; flex-direction:column; gap:0;"></div>

          <!-- Leyenda -->
          <div class="leyenda">
            <div class="leyenda-item"><div class="leyenda-dot" style="background:#555450;"></div>Sin revisar</div>
            <div class="leyenda-item"><div class="leyenda-dot" style="background:#3B9B5C;"></div>Sin consumo</div>
            <div class="leyenda-item"><div class="leyenda-dot" style="background:#D94F4F;"></div>Con consumo</div>
            <div class="leyenda-item"><div class="leyenda-dot" style="background:#E09B35;"></div>Captura</div>
          </div>
        </div>
        <div class="pdf-loading" id="pdf-loading">
          <div class="pdf-spinner"></div>
          <span>Cargando diagrama...</span>
        </div>
        <canvas id="pdf-canvas" style="display:none;"></canvas>

        
        
      </div>

      <!-- Tooltip flotante -->
      <div class="punto-tooltip" id="punto-tooltip">
        <div class="tooltip-title" id="tooltip-title">E1</div>
        <div class="tooltip-btns" id="tooltip-btns"></div>
      </div>
    </div>

  </div>
<% } %>

<% if (diagrama) { %>
<script>
pdfjsLib.GlobalWorkerOptions.workerSrc =
  'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

const VISITA_ID = '<%= visita.id %>';
const PDF_URL   = '/tecnico/diagramas-upc/<%= diagrama.id %>/pdf';

const ESTACIONES = <%- JSON.stringify(
  estaciones.reduce((acc, e) => {
    acc[e.numero] = { id: e.id, consumo: e.consumo || 'pendiente', tipo: e.tipo };
    return acc;
  }, {})
) %>;

const PUNTOS = <%- JSON.stringify(puntos) %>;

const mapWrap   = document.getElementById('map-wrap');
const container = document.getElementById('pages-container');
const tooltip   = document.getElementById('punto-tooltip');

// ── Toggle lista móvil ────────────────────────────────────────────────────────
var toggleBtn = document.getElementById('mini-toggle');
var miniList  = document.querySelector('.mini-list');
if (toggleBtn && miniList) {
  toggleBtn.addEventListener('click', function() {
    miniList.classList.toggle('open');
    toggleBtn.textContent = miniList.classList.contains('open')
      ? '▲ Ocultar estaciones'
      : '▼ Ver estaciones (<%= estaciones.length %>)';
  });
}

// ── Renderizar todas las páginas apiladas ────────────────────────────────────
async function loadPDF() {
  var pdf       = await pdfjsLib.getDocument(PDF_URL).promise;
  var totalPags = pdf.numPages;

  for (var i = 1; i <= totalPags; i++) {
    var page     = await pdf.getPage(i);
    var viewport = page.getViewport({ scale: 1.5 });

    var wrapper = document.createElement('div');
    wrapper.style.cssText  = 'position:relative; display:block; line-height:0;';
    wrapper.dataset.pagina = i;

    var canvas = document.createElement('canvas');
    canvas.width  = viewport.width;
    canvas.height = viewport.height;
    canvas.style.cssText = 'display:block; width:100%; height:auto;';

    wrapper.appendChild(canvas);
    container.appendChild(wrapper);

    await page.render({ canvasContext: canvas.getContext('2d'), viewport }).promise;
  }

  // Ocultar DESPUÉS de que todos los canvas están renderizados
  document.getElementById('pdf-loading').style.display = 'none';
  renderPuntos();
}

loadPDF();

// ── Renderizar todos los puntos en su página ──────────────────────────────────
function renderPuntos() {
  document.querySelectorAll('.mapa-punto').forEach(function(el) { el.remove(); });

  PUNTOS.forEach(function(p) {
    var est    = ESTACIONES[p.numero];
    var estado = est ? est.consumo : 'pendiente';
    var pg     = p.pagina || 1;

    var wrapper = container.querySelector('[data-pagina="' + pg + '"]');
    if (!wrapper) return;

    var dot = document.createElement('div');
    dot.className   = 'mapa-punto ' + estado;
    dot.id          = 'dot-' + p.numero;
    dot.textContent = p.numero;
    dot.style.left  = p.x_pct + '%';
    dot.style.top   = p.y_pct + '%';

    dot.addEventListener('click', function(e) {
      e.stopPropagation();
      showTooltip(p.numero, e.clientX, e.clientY, wrapper);
    });

    wrapper.appendChild(dot);
  });
}

// ── Tooltip ───────────────────────────────────────────────────────────────────
function showTooltip(numero, clientX, clientY, wrapper) {
  var est   = ESTACIONES[numero];
  var tipos = { quimica: 'Química', mecanica: 'Mecánica', ecologica: 'Ecológica' };

  document.getElementById('tooltip-title').textContent =
    'E' + numero + ' — ' + (tipos[est && est.tipo] || '');

  var btns = document.getElementById('tooltip-btns');
  btns.innerHTML =
    '<button class="tooltip-btn" onclick="setConsumo(' + numero + ',\'sin_consumo\')">' +
      '<span class="dot dot-sc"></span> Sin consumo</button>' +
    '<button class="tooltip-btn" onclick="setConsumo(' + numero + ',\'con_consumo\')">' +
      '<span class="dot dot-cc"></span> Con consumo</button>' +
    '<button class="tooltip-btn" onclick="setConsumo(' + numero + ',\'captura\')">' +
      '<span class="dot dot-cap"></span> Hubo captura</button>';

  tooltip.style.display = 'block';
  tooltip.classList.add('visible');

  var rect = wrapper.getBoundingClientRect();
  var tx   = clientX - rect.left + 16;
  var ty   = clientY - rect.top  - 20;
  if (tx + 180 > rect.width)  tx -= 200;
  if (ty + 120 > rect.height) ty -= 130;
  tooltip.style.position = 'absolute';
  tooltip.style.left     = tx + 'px';
  tooltip.style.top      = ty + 'px';
  wrapper.appendChild(tooltip);
}

document.addEventListener('click', function(e) {
  if (!e.target.closest('.mapa-punto') && !e.target.closest('.punto-tooltip')) {
    tooltip.classList.remove('visible');
    document.querySelectorAll('.mapa-punto').forEach(function(d) {
      d.classList.remove('highlight');
    });
  }
});

// ── Actualizar consumo ────────────────────────────────────────────────────────
async function setConsumo(numero, consumo) {
  var est = ESTACIONES[numero];
  if (!est) return;

  tooltip.classList.remove('visible');
  ESTACIONES[numero].consumo = consumo;

  var dot = document.getElementById('dot-' + numero);
  if (dot) dot.className = 'mapa-punto ' + consumo;

  var colorMap = {
    sin_consumo: '#3B9B5C', con_consumo: '#D94F4F',
    captura: '#E09B35', pendiente: '#555450',
  };
  var miniDot = document.querySelector('#mini-' + est.id + ' .mini-dot');
  if (miniDot) miniDot.style.background = colorMap[consumo] || colorMap.pendiente;

  await fetch('/tecnico/estacion/' + est.id, {
    method:  'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body:    JSON.stringify({ consumo: consumo }),
  });
}

// ── Highlight desde lista lateral ─────────────────────────────────────────────
function highlightPunto(numero) {
  document.querySelectorAll('.mapa-punto').forEach(function(d) {
    d.classList.remove('highlight');
  });
  var dot = document.getElementById('dot-' + numero);
  if (dot) {
    dot.classList.add('highlight');
    dot.scrollIntoView({ behavior: 'smooth', block: 'center' });
    setTimeout(function() { dot.classList.remove('highlight'); }, 2500);
  }
}
</script>
<% } %>

</body>
</html>