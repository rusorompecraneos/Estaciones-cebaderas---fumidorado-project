<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css"/>

  <%# IMPORTANTE: configurar workerSrc ANTES de cargar pdf.min.js %>
  <script>
    window.pdfjsWorkerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  </script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script>
    // Configurar worker inmediatamente después de cargar la librería
    if (typeof pdfjsLib !== 'undefined') {
      pdfjsLib.GlobalWorkerOptions.workerSrc = window.pdfjsWorkerSrc;
    }
  </script>

  <style>
    /* ── Base ── */
    body { background:var(--color-bg); color:var(--color-text); font-family:var(--font-body); }

    /* ── Topbar (solo pantalla) ── */
    .rpt-topbar {
      display:flex; align-items:center; justify-content:space-between;
      padding:var(--space-4) var(--space-8);
      background:var(--color-surface); border-bottom:1px solid var(--color-border);
      position:sticky; top:0; z-index:50;
    }
    .rpt-topbar__left { display:flex; align-items:center; gap:var(--space-4); }
    .rpt-topbar__back {
      display:flex; align-items:center; gap:var(--space-2);
      color:var(--color-text-muted); text-decoration:none;
      transition:color var(--transition-fast);
    }
    .rpt-topbar__back:hover { color:var(--color-gold); }
    .rpt-topbar__title { font-family:var(--font-display); font-size:var(--text-lg); font-weight:var(--weight-semi); }
    .rpt-topbar__sub   { font-size:var(--text-xs); color:var(--color-text-muted); }
    .rpt-topbar__actions { display:flex; gap:var(--space-3); }

    /* ── Contenido del reporte ── */
    .rpt-page {
      max-width:900px; margin:0 auto;
      padding:var(--space-8) var(--space-6);
      display:flex; flex-direction:column; gap:var(--space-8);
    }

    /* ── Encabezado ── */
    .rpt-header {
      display:flex; align-items:flex-start; justify-content:space-between;
      padding-bottom:var(--space-6); border-bottom:2px solid var(--color-gold);
      gap:var(--space-4); flex-wrap:wrap;
    }
    .rpt-header__logo {
      width:52px; height:52px; background:var(--color-gold);
      border-radius:var(--radius-lg); display:flex; align-items:center; justify-content:center;
      font-family:var(--font-display); font-weight:800; font-size:var(--text-lg); color:#111;
      flex-shrink:0;
    }
    .rpt-header__brand { display:flex; align-items:center; gap:var(--space-4); }
    .rpt-header__name  { font-family:var(--font-display); font-size:var(--text-xl); font-weight:var(--weight-bold); }
    .rpt-header__sub   { font-size:var(--text-sm); color:var(--color-text-muted); }
    .rpt-header__meta  { text-align:right; }
    .rpt-header__code  { font-size:var(--text-xs); color:var(--color-text-faint); }
    .rpt-header__date  { font-family:var(--font-display); font-size:var(--text-md); font-weight:var(--weight-semi); color:var(--color-gold); margin-top:4px; }

    /* ── Info de servicio ── */
    .rpt-info-grid {
      display:grid; grid-template-columns:repeat(3,1fr);
      gap:var(--space-3);
    }
    .rpt-info-field {
      background:var(--color-surface);
      border:1px solid var(--color-border);
      border-radius:var(--radius-md);
      padding:var(--space-3) var(--space-4);
    }
    .rpt-info-field__label { font-size:var(--text-xs); color:var(--color-text-muted); margin-bottom:3px; font-weight: 600; }
    .rpt-info-field__value { font-size:var(--text-sm); font-weight:600; color:var(--color-text); }

    /* ── Stats ── */
    .rpt-stats {
      display:grid; grid-template-columns:repeat(4,1fr);
      gap:var(--space-4);
    }
    .rpt-stat {
      background:var(--color-surface); border:1px solid var(--color-border);
      border-radius:var(--radius-lg); padding:var(--space-4) var(--space-5);
      text-align:center;
    }
    .rpt-stat__num   { font-family:var(--font-display); font-size:var(--text-2xl); font-weight:var(--weight-bold); }
    .rpt-stat__label { font-size:var(--text-xs); color:var(--color-text-muted); margin-top:4px; }
    .rpt-stat--total   .rpt-stat__num { color:var(--color-text); }
    .rpt-stat--cc      .rpt-stat__num { color:#D94F4F; }
    .rpt-stat--sc      .rpt-stat__num { color:#3B9B5C; }
    .rpt-stat--captura .rpt-stat__num { color:#E09B35; }

    /* Barra de progreso */
    .rpt-progress { display:flex; flex-direction:column; gap:var(--space-2); }
    .rpt-progress__label { font-size:var(--text-sm); color:var(--color-text-muted); display:flex; justify-content:space-between; }
    .rpt-progress__bar { height:8px; background:var(--color-surface-2); border-radius:99px; overflow:hidden; display:flex; }
    .rpt-progress__cc  { background:#D94F4F; }
    .rpt-progress__sc  { background:#3B9B5C; }
    .rpt-progress__cap { background:#E09B35; }
    .rpt-progress__pen { background:var(--color-surface-3); }

    /* ── Mapa de calor ── */
    .rpt-section-title {
      font-family:var(--font-display); font-size:var(--text-md);
      font-weight:var(--weight-semi); color:var(--color-text);
      padding-bottom:var(--space-3); border-bottom:1px solid var(--color-border);
      margin-bottom:var(--space-4);
      display:flex; align-items:center; gap:var(--space-2);
    }

    .mapa-wrap {
      position:relative;
      width:100%; border-radius:var(--radius-lg);
      border:1px solid var(--color-border);
      background:var(--color-surface-2);
      overflow:hidden;
    }
    #rpt-canvas { width:100%; height:auto; display:block; }

    /* Leyenda del mapa */
    .mapa-leyenda {
      display:flex; gap:var(--space-5); flex-wrap:wrap;
      padding:var(--space-3) var(--space-4);
      background:var(--color-surface-2);
      border:1px solid var(--color-border);
      border-radius:var(--radius-md);
    }
    .mapa-leyenda__item { display:flex; align-items:center; gap:var(--space-2); font-size:var(--text-xs); color:var(--color-text-muted); }
    .mapa-leyenda__dot  { width:10px; height:10px; border-radius:50%; flex-shrink:0; }

    .mapa-no-diagrama {
      padding:var(--space-10); text-align:center;
      background:var(--color-surface-2); border:1px solid var(--color-border);
      border-radius:var(--radius-lg); color:var(--color-text-faint);
      font-size:var(--text-sm);
    }

    /* ── Tabla de detalle ── */
    .rpt-table-wrap { border:1px solid var(--color-border); border-radius:var(--radius-lg); overflow:hidden; }
    table { width:100%; border-collapse:collapse; font-size:var(--text-sm); }
    thead { background:var(--color-surface-2); }
    thead th {
      padding:var(--space-3) var(--space-4); text-align:left;
      font-family:var(--font-display); font-weight:var(--weight-semi);
      font-size:var(--text-xs); color:var(--color-text-muted);
      text-transform:uppercase; letter-spacing:.06em;
      border-bottom:1px solid var(--color-border);
    }
    tbody tr { border-bottom:1px solid var(--color-border); }
    tbody tr:last-child { border-bottom:none; }
    tbody td { padding:var(--space-3) var(--space-4); color:var(--color-text); vertical-align:top; }
    .td-muted { color:var(--color-text-muted); font-size:var(--text-xs); }

    .consumo-badge {
      display:inline-flex; align-items:center; gap:4px;
      padding:2px var(--space-3); border-radius:var(--radius-full);
      font-size:var(--text-xs); font-weight:500;
    }
    .consumo-badge.sin_consumo { background:rgba(59,155,92,.15);   color:#3B9B5C; }
    .consumo-badge.con_consumo { background:rgba(217,79,79,.15);    color:#D94F4F; }
    .consumo-badge.captura     { background:rgba(224,155,53,.15);   color:#E09B35; }
    .consumo-badge.pendiente   { background:var(--color-surface-3); color:var(--color-text-faint); }

    .repone-badge { font-size:var(--text-xs); font-weight:500; }
    .repone-badge.si { color:#3B9B5C; }
    .repone-badge.no { color:#D94F4F; }

    /* ── Firmas ── */
    .firmas-grid {
      display:grid; grid-template-columns:1fr 1fr;
      gap:var(--space-8);
      padding-top:var(--space-8);
      border-top:1px solid var(--color-border);
    }
    .firma-box { display:flex; flex-direction:column; gap:var(--space-2); }
    .firma-box__line { border-top:1px solid var(--color-text-muted); padding-top:var(--space-2); font-size:var(--text-xs); color:var(--color-text-muted); }
    .firma-box__name { font-size:var(--text-sm); font-weight:500; margin-top:var(--space-1); }
    .firma-box__space { height:60px; }

    /* ── Footer del reporte ── */
    .rpt-footer-bar {
      text-align:center; font-size:var(--text-xs); color:var(--color-text-faint);
      padding-top:var(--space-4); border-top:1px solid var(--color-border);
    }

    /* ── PDF loading / error ── */
    .pdf-loading {
      padding:var(--space-8); text-align:center;
      color:var(--color-text-muted); font-size:var(--text-sm);
    }
    .pdf-spinner {
      width:28px; height:28px; border:3px solid var(--color-border);
      border-top-color:var(--color-gold); border-radius:50%;
      animation:spin .8s linear infinite; margin:0 auto var(--space-3);
    }
    .pdf-error {
      padding:var(--space-6); text-align:center;
      color:var(--color-error); font-size:var(--text-sm); display:none;
    }
    @keyframes spin { to { transform:rotate(360deg); } }

    /* ── Print ── */
    @media print {
  .rpt-topbar { display:none !important; }

  body {
    background: #ffffff !important;
    color: #111111 !important;
  }

  /* Textos */
  .rpt-info-field__label,
  .rpt-stat__label,
  .td-muted,
  .rpt-topbar__sub,
  .rpt-header__sub,
  .rpt-progress__label,
  .rpt-footer-bar,
  .mapa-leyenda__item,
  .firma-box__line {
    color: #444444 !important;
  }

  .rpt-info-field__value,
  .rpt-stat__num,
  .rpt-section-title,
  .rpt-header__name,
  tbody td,
  thead th,
  .firma-box__name {
    color: #111111 !important;
  }

  .rpt-header__date { color: #b07d10 !important; }

  /* Fondos */
  .rpt-stat,
  .rpt-info-field,
  .mapa-wrap,
  .mapa-leyenda,
  .rpt-table-wrap,
  .rpt-fotos-section {
    background: #ffffff !important;
    border-color: #cccccc !important;
  }

  thead { background: #f5f5f5 !important; }

  /* Badges de consumo — mantener colores pero con fondo claro */
  .consumo-badge.sin_consumo { background: #d4f0df !important; color: #1e6e3a !important; }
  .consumo-badge.con_consumo { background: #fad4d4 !important; color: #8b1a1a !important; }
  .consumo-badge.captura     { background: #faecd4 !important; color: #7a4e00 !important; }
  .consumo-badge.pendiente   { background: #eeeeee !important; color: #555555 !important; }

  .repone-badge.si { color: #1e6e3a !important; }
  .repone-badge.no { color: #8b1a1a !important; }

  /* Canvas / mapa */
  .rpt-page   { padding: 20px !important; max-width: 100% !important; }
  #rpt-canvas       { display: none !important; }
  #rpt-canvas-print { width: 100% !important; height: auto !important; display: block !important; }

  /* Fotos */
  .rpt-foto-thumb { border-color: #cccccc !important; page-break-inside: avoid; }
  .rpt-fotos-section { grid-template-columns: repeat(3, 1fr); }
}

    @media(max-width:768px) {
      .rpt-info-grid { grid-template-columns:1fr 1fr; }
      .rpt-stats     { grid-template-columns:repeat(2,1fr); }
      .firmas-grid   { grid-template-columns:1fr; }
      .rpt-page      { padding:var(--space-4); }
      .rpt-topbar    { padding:var(--space-4); }
    }
    

  #rpt-canvas-print {
    display: block !important;
    width: 100%;
    height: auto;
  }
  

  /* ── Fotos por estación ── */
.rpt-fotos-section {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
.rpt-fotos-est {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.rpt-fotos-est__label {
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-text);
  display: flex;
  align-items: center;
  gap: var(--space-1);
  flex-wrap: wrap;
}
.rpt-fotos-est__num {
  background: var(--color-surface-2);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 1px 6px;
  font-family: var(--font-display);
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}
.rpt-fotos-grid {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.rpt-foto-thumb {
  border-radius: 4px;
  overflow: hidden;
  border: 1px solid var(--color-border);
  aspect-ratio: 4/3;
  background: var(--color-surface-2);
}
.rpt-foto-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}


  </style>
</head>
<body>

<header class="rpt-topbar">
  <div class="rpt-topbar__left">
    <a href="<%= backUrl %>" class="rpt-topbar__back">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </a>
    <div>
      <div class="rpt-topbar__title">Reporte de visita</div>
      <div class="rpt-topbar__sub">
        <%= visita.cliente_codigo %> — <%= visita.cliente_nombre %> &nbsp;·&nbsp;
        Sede <%= visita.sede_codigo %> · <%= visita.sede_nombre %>
      </div>
    </div>
  </div>
  <div class="rpt-topbar__actions">
    <button class="btn btn--primary btn--sm" onclick="window.print()">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="6 9 6 2 18 2 18 9"/>
        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
        <rect x="6" y="14" width="12" height="8"/>
      </svg>
      Imprimir / Guardar PDF
    </button>
  </div>
</header>

<div class="rpt-page">

  <!-- Encabezado de marca -->
  <div class="rpt-header">
    <div class="rpt-header__brand">
      <div class="rpt-header__logo">FD</div>
      <div>
        <div class="rpt-header__name">Fumi Dorado S.A.S.</div>
        <div class="rpt-header__sub">Control de estaciones cebaderas</div>
      </div>
    </div>
    <div class="rpt-header__meta">
      <div class="rpt-header__code">SGC-Fo 8506 / Versión 5</div>
      <div class="rpt-header__date">
        <%= new Date(visita.fecha).toLocaleDateString('es-CO', {day:'2-digit', month:'long', year:'numeric'}) %>
      </div>
    </div>
  </div>

  <!-- Info del servicio -->
  <div>
    <div class="rpt-section-title">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="2" y="7" width="20" height="14" rx="2"/>
        <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
      </svg>
      Información del servicio
    </div>
    <div class="rpt-info-grid">
      <div class="rpt-info-field">
        <div class="rpt-info-field__label">Cliente</div>
        <div class="rpt-info-field__value"><%= visita.cliente_codigo %> — <%= visita.cliente_nombre %></div>
      </div>
      <div class="rpt-info-field">
        <div class="rpt-info-field__label">Sede</div>
        <div class="rpt-info-field__value"><%= visita.sede_codigo %> — <%= visita.sede_nombre %></div>
      </div>
      <div class="rpt-info-field">
        <div class="rpt-info-field__label">Técnico</div>
        <div class="rpt-info-field__value"><%= visita.tecnico_nombre %></div>
      </div>
      <div class="rpt-info-field">
        <div class="rpt-info-field__label">Fecha</div>
        <div class="rpt-info-field__value">
          <%= new Date(visita.fecha).toLocaleDateString('es-CO', {day:'2-digit', month:'long', year:'numeric'}) %>
        </div>
      </div>
      <div class="rpt-info-field">
        <div class="rpt-info-field__label">Hora inicio</div>
        <div class="rpt-info-field__value"><%= visita.hora_inicio ? visita.hora_inicio.slice(0,5) : '—' %></div>
      </div>
      <div class="rpt-info-field">
        <div class="rpt-info-field__label">Hora fin</div>
        <div class="rpt-info-field__value"><%= visita.hora_fin ? visita.hora_fin.slice(0,5) : '—' %></div>
      </div>
      <div class="rpt-info-field">
        <div class="rpt-info-field__label">Fecha de ejecución</div>
        <div class="rpt-info-field__value">
          <%= visita.fecha_ejecucion
            ? new Date(visita.fecha_ejecucion).toLocaleDateString('es-CO', {day:'2-digit', month:'long', year:'numeric'})
            : '—' %>
      </div>
      </div>
        <div class="rpt-info-field">
          <div class="rpt-info-field__label">Número de OS</div>
          <div class="rpt-info-field__value"><%= visita.os || '—' %></div>
        </div>
      </div>
    </div>

  <!-- Estadísticas -->
  <div>
    <div class="rpt-section-title">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="20" x2="18" y2="10"/>
        <line x1="12" y1="20" x2="12" y2="4"/>
        <line x1="6"  y1="20" x2="6"  y2="14"/>
      </svg>
      Resumen de consumo
    </div>
    <div class="rpt-stats">
      <div class="rpt-stat rpt-stat--total">
        <div class="rpt-stat__num"><%= stats.total %></div>
        <div class="rpt-stat__label">Total estaciones</div>
      </div>
      <div class="rpt-stat rpt-stat--cc">
        <div class="rpt-stat__num"><%= stats.con_consumo %></div>
        <div class="rpt-stat__label">Con consumo</div>
      </div>
      <div class="rpt-stat rpt-stat--sc">
        <div class="rpt-stat__num"><%= stats.sin_consumo %></div>
        <div class="rpt-stat__label">Sin consumo</div>
      </div>
      <div class="rpt-stat rpt-stat--captura">
        <div class="rpt-stat__num"><%= stats.captura %></div>
        <div class="rpt-stat__label">Capturas</div>
      </div>
    </div>
    <% if (stats.total > 0) { %>
      <div class="rpt-progress" style="margin-top:var(--space-4);">
        <div class="rpt-progress__label">
          <span>Progreso de revisión</span>
          <span><%= stats.total - stats.pendiente %> de <%= stats.total %> revisadas</span>
        </div>
        <div class="rpt-progress__bar">
          <div class="rpt-progress__cc"  style="width:<%= stats.con_consumo/stats.total*100 %>%;"></div>
          <div class="rpt-progress__sc"  style="width:<%= stats.sin_consumo/stats.total*100 %>%;"></div>
          <div class="rpt-progress__cap" style="width:<%= stats.captura/stats.total*100 %>%;"></div>
          <div class="rpt-progress__pen" style="width:<%= stats.pendiente/stats.total*100 %>%;"></div>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Mapa de calor -->
  <div>
    <div class="rpt-section-title">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polygon points="3 11 22 2 13 21 11 13 3 11"/>
      </svg>
      Mapa de calor — Diagrama UPC
    </div>

    <% if (diagrama) { %>
      <div class="mapa-wrap" id="mapa-wrap">
        <div class="pdf-loading" id="pdf-loading">
          <div class="pdf-spinner"></div>
          Cargando diagrama...
        </div>
        <div class="pdf-error" id="pdf-error">
          No se pudo cargar el diagrama. <a href="#" onclick="renderMapa(); return false;">Reintentar</a>
        </div>
        <canvas id="rpt-canvas"></canvas>
      </div>
      <div class="mapa-leyenda" style="margin-top:var(--space-3);">
        <div class="mapa-leyenda__item"><div class="mapa-leyenda__dot" style="background:#3B9B5C;"></div>Sin consumo</div>
        <div class="mapa-leyenda__item"><div class="mapa-leyenda__dot" style="background:#D94F4F;"></div>Con consumo</div>
        <div class="mapa-leyenda__item"><div class="mapa-leyenda__dot" style="background:#E09B35;"></div>Captura</div>
        <div class="mapa-leyenda__item"><div class="mapa-leyenda__dot" style="background:#555450;"></div>Sin revisar</div>
      </div>
    <% } else { %>
      <div class="mapa-no-diagrama">
        No hay diagrama UPC configurado para esta sede.
      </div>
    <% } %>
  </div>

  <!-- Detalle de estaciones -->
  <div>
    <div class="rpt-section-title">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="8" y1="6" x2="21" y2="6"/>
        <line x1="8" y1="12" x2="21" y2="12"/>
        <line x1="8" y1="18" x2="21" y2="18"/>
        <line x1="3" y1="6"  x2="3.01" y2="6"/>
        <line x1="3" y1="12" x2="3.01" y2="12"/>
        <line x1="3" y1="18" x2="3.01" y2="18"/>
      </svg>
      Detalle de estaciones cebaderas
    </div>
    <div class="rpt-table-wrap">
      <table>
        <thead>
          <tr>
            <th>#</th><th>Tipo</th><th>Consumo</th>
            <th>¿Repone?</th><th>Novedad</th><th>Observaciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (estaciones.length === 0) { %>
            <tr><td colspan="6" style="text-align:center;padding:var(--space-6);color:var(--color-text-faint);">Sin estaciones registradas.</td></tr>
          <% } %>
          <% estaciones.forEach(est => { %>
            <tr>
              <td><strong>E<%= est.numero %></strong></td>
              <td class="td-muted">
                <%= est.tipo === 'quimica' ? 'Química' : est.tipo === 'mecanica' ? 'Mecánica' : 'Ecológica' %>
              </td>
              <td>
                <span class="consumo-badge <%= est.consumo || 'pendiente' %>">
                  <span style="width:6px;height:6px;border-radius:50%;background:currentColor;display:inline-block;"></span>
                  <%= est.consumo === 'sin_consumo' ? 'Sin consumo' :
                      est.consumo === 'con_consumo' ? 'Con consumo' :
                      est.consumo === 'captura'     ? 'Captura'     : 'Pendiente' %>
                </span>
              </td>
              <td>
                <% if (est.repone === true) { %>
                  <span class="repone-badge si">✓ Sí</span>
                <% } else if (est.repone === false) { %>
                  <span class="repone-badge no">✗ No</span>
                <% } else { %>
                  <span class="td-muted">—</span>
                <% } %>
              </td>
              <td class="td-muted"><%= est.novedad || '—' %></td>
              <td class="td-muted"><%= est.observaciones || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Fotografías por estación -->
<% const estacionesConFotos = estaciones.filter(e => e.fotos && e.fotos.length > 0); %>
<% if (estacionesConFotos.length > 0) { %>
<div>
  <div class="rpt-section-title">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
      <circle cx="12" cy="13" r="4"/>
    </svg>
    Fotografías por estación
  </div>
  <div class="rpt-fotos-section">
    <% estacionesConFotos.forEach(est => { %>
      <div class="rpt-fotos-est">
        <div class="rpt-fotos-est__label">
          <span class="rpt-fotos-est__num">E<%= est.numero %></span>
          <%= est.tipo === 'quimica' ? 'Química' : est.tipo === 'mecanica' ? 'Mecánica' : 'Ecológica' %>
          <span class="td-muted">— <%= est.fotos.length %> foto<%= est.fotos.length !== 1 ? 's' : '' %></span>
        </div>
        <div class="rpt-fotos-grid">
          <% est.fotos.forEach(foto => { %>
            <div class="rpt-foto-thumb">
              <img src="/fotos-servicio/<%= foto.filename %>" alt="Foto E<%= est.numero %>" loading="lazy"/>
            </div>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>
</div>
<% } %>


  <!-- Firmas -->
  <div class="firmas-grid">
    <div class="firma-box">
      <div class="firma-box__space"></div>
      <div class="firma-box__line">Firma técnico responsable</div>
      <div class="firma-box__name"><%= visita.tecnico_nombre %></div>
    </div>
    <div class="firma-box">
      <div class="firma-box__space"></div>
      <div class="firma-box__line">Firma cliente / receptor</div>
      <div class="firma-box__name">&nbsp;</div>
    </div>
  </div>

  <div class="rpt-footer-bar">
  SGC-Fo 8506 / Versión 5 · Aprobado por: F.D ·
    Generado el <%= new Date().toLocaleDateString('es-CO', {day:'2-digit', month:'long', year:'numeric'}) %>
  </div>

</div>

<% if (diagrama) { %>
<script>
// ── Datos del servidor ────────────────────────────────────────────────────────
const PDF_URL = '/admin/diagramas/<%= diagrama.id %>/pdf';
const PUNTOS  = <%- JSON.stringify(puntos) %>;
const CONSUMO_MAP = <%- JSON.stringify(
  estaciones.reduce((acc, e) => {
    acc[e.numero] = e.consumo || 'pendiente';
    return acc;
  }, {})
) %>;

const CONSUMO_COLORS = {
  sin_consumo: { r: 59,  g: 155, b: 92  },
  con_consumo: { r: 217, g: 79,  b: 79  },
  captura:     { r: 224, g: 155, b: 53  },
  pendiente:   { r: 85,  g: 84,  b: 80  },
};

// ── Dibujar heatmap + puntos sobre el canvas ──────────────────────────────────
function dibujarHeatmap(canvas, ctx, puntosPagina) {
  const W = canvas.width;
  const H = canvas.height;
  const baseRadius = Math.min(W, H) * 0.09;
  const DOT_R      = Math.min(W, H) * 0.018;
  const FONT_SZ    = Math.max(9, DOT_R * 1.1);

  puntosPagina.forEach(p => {
    const col = CONSUMO_COLORS[CONSUMO_MAP[p.numero] || 'pendiente'];
    const cx  = (p.x_pct / 100) * W;
    const cy  = (p.y_pct / 100) * H;

    const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, baseRadius);
    grad.addColorStop(0,    `rgba(${col.r},${col.g},${col.b},0.70)`);
    grad.addColorStop(0.35, `rgba(${col.r},${col.g},${col.b},0.45)`);
    grad.addColorStop(0.70, `rgba(${col.r},${col.g},${col.b},0.18)`);
    grad.addColorStop(1,    `rgba(${col.r},${col.g},${col.b},0.00)`);

    ctx.beginPath();
    ctx.arc(cx, cy, baseRadius, 0, Math.PI * 2);
    ctx.fillStyle = grad;
    ctx.fill();
  });

  puntosPagina.forEach(p => {
    const col = CONSUMO_COLORS[CONSUMO_MAP[p.numero] || 'pendiente'];
    const cx  = (p.x_pct / 100) * W;
    const cy  = (p.y_pct / 100) * H;

    ctx.shadowColor  = 'rgba(0,0,0,0.35)';
    ctx.shadowBlur   = 4;
    ctx.beginPath();
    ctx.arc(cx, cy, DOT_R, 0, Math.PI * 2);
    ctx.fillStyle = `rgb(${col.r},${col.g},${col.b})`;
    ctx.fill();

    ctx.shadowBlur   = 0;
    ctx.strokeStyle  = 'rgba(255,255,255,0.9)';
    ctx.lineWidth    = 1.5;
    ctx.stroke();

    ctx.fillStyle    = '#ffffff';
    ctx.font         = `bold ${FONT_SZ}px sans-serif`;
    ctx.textAlign    = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(p.numero, cx, cy);
  });
}

// ── Renderizar PDF ────────────────────────────────────────────────────────────
async function renderMapa() {
  const loadingEl = document.getElementById('pdf-loading');
  const errorEl   = document.getElementById('pdf-error');
  const container = document.getElementById('mapa-wrap');

  loadingEl.style.display = 'block';
  errorEl.style.display   = 'none';

  // Limpiar canvases anteriores si los hay
  container.querySelectorAll('canvas, .rpt-pagina-label').forEach(function(el) { el.remove(); });

  try {
    const pdf = await Promise.race([
      pdfjsLib.getDocument({ url: PDF_URL, maxImageSize: -1 }).promise,
      new Promise(function(_, reject) {
        setTimeout(function() { reject(new Error('Timeout')); }, 15000);
      }),
    ]);

    const totalPaginas      = pdf.numPages;
    const paginasConPuntos  = [...new Set(PUNTOS.map(function(p) { return p.pagina || 1; }))].sort(function(a,b){ return a-b; });
    const paginasARenderizar = paginasConPuntos.length > 0 ? paginasConPuntos : [1];

    for (var i = 0; i < paginasARenderizar.length; i++) {
      var numPagina = paginasARenderizar[i];
      if (numPagina > totalPaginas) continue;

      // Etiqueta solo si hay más de una página
      if (paginasARenderizar.length > 1) {
        var label = document.createElement('div');
        label.className   = 'rpt-pagina-label';
        label.textContent = 'Página ' + numPagina;
        label.style.cssText = 'font-size:var(--text-xs);color:var(--color-text-faint);padding:var(--space-2) 0;';
        container.appendChild(label);
      }

      var page     = await pdf.getPage(numPagina);
      var viewport = page.getViewport({ scale: 1.5 });

      var canvas   = document.createElement('canvas');
      canvas.width  = viewport.width;
      canvas.height = viewport.height;
      canvas.style.cssText  = 'width:100%;height:auto;display:block;margin-bottom:var(--space-2);';
      canvas.dataset.pagina = numPagina;
      container.appendChild(canvas);

      await page.render({ canvasContext: canvas.getContext('2d'), viewport }).promise;

      var puntosPagina = PUNTOS.filter(function(p) { return (p.pagina || 1) === numPagina; });
      dibujarHeatmap(canvas, canvas.getContext('2d'), puntosPagina);
    }

    loadingEl.style.display = 'none';

  } catch(err) {
    console.error('[Reporte] Error:', err.message);
    loadingEl.style.display = 'none';
    errorEl.style.display   = 'block';
  }
}

// ── Esperar a que el DOM esté completamente cargado ───────────────────────────
// Este era el problema principal: renderMapa() se llamaba antes de que
// el canvas estuviera disponible en el DOM cuando la página venía de
// un estado de caché parcial.
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', renderMapa);
} else {
  // DOM ya listo (caso normal en navegación directa)
  renderMapa();
}

// ── Fix impresión: canvas → imagen antes de imprimir ─────────────────────────
window.addEventListener('beforeprint', function() {
  document.querySelectorAll('#mapa-wrap canvas').forEach(function(canvas) {
    var img       = document.createElement('img');
    img.className = 'rpt-canvas-print';
    img.src       = canvas.toDataURL('image/png');
    img.style.cssText = 'width:100%;height:auto;display:block;margin-bottom:8px;';
    canvas.parentNode.insertBefore(img, canvas);
    canvas.style.display = 'none';
  });
});

window.addEventListener('afterprint', function() {
  document.querySelectorAll('.rpt-canvas-print').forEach(function(img) { img.remove(); });
  document.querySelectorAll('#mapa-wrap canvas').forEach(function(c) { c.style.display = 'block'; });
});
</script>
<% } %>

</body>
</html>
