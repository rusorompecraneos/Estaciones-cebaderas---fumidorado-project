<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css" />
  <style>
    /* ── Layout ── */
    .dashboard-page {
      min-height: 100vh;
      background: var(--color-bg);
      display: flex;
      flex-direction: column;
    }

    /* ── Topbar ── */
    .dash-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: var(--space-4) var(--space-8);
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .dash-topbar__brand {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .dash-topbar__logo {
      width: 38px;
      height: 38px;
      background: var(--color-gold);
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-weight: var(--weight-bold);
      font-size: var(--text-sm);
      color: #111;
      flex-shrink: 0;
    }

    .dash-topbar__name {
      font-family: var(--font-display);
      font-size: var(--text-md);
      font-weight: var(--weight-semi);
      color: var(--color-text);
      line-height: 1.2;
    }

    .dash-topbar__sub {
      font-size: var(--text-xs);
      color: var(--color-text-muted);
    }

    .dash-topbar__right {
      display: flex;
      align-items: center;
      gap: var(--space-4);
    }

    .dash-topbar__user {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .dash-topbar__avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--color-gold);
      color: #111;
      font-family: var(--font-display);
      font-weight: var(--weight-bold);
      font-size: var(--text-xs);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .dash-topbar__username {
      font-size: var(--text-sm);
      font-weight: var(--weight-medium);
      color: var(--color-text);
      line-height: 1.2;
    }

    .dash-topbar__role {
      font-size: var(--text-xs);
      color: var(--color-text-muted);
    }

    .dash-topbar__logout {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-md);
      border: 1px solid var(--color-border);
      background: transparent;
      color: var(--color-text-muted);
      font-size: var(--text-xs);
      font-family: var(--font-display);
      font-weight: var(--weight-medium);
      cursor: pointer;
      text-decoration: none;
      transition: all var(--transition-fast);
    }

    .dash-topbar__logout:hover {
      border-color: var(--color-error);
      color: var(--color-error);
    }

    /* ── Contenido principal ── */
    .dash-content {
      flex: 1;
      max-width: 1100px;
      width: 100%;
      margin: 0 auto;
      padding: var(--space-12) var(--space-8);
      display: flex;
      flex-direction: column;
      gap: var(--space-10);
    }

    /* ── Encabezado bienvenida ── */
    .dash-welcome {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding-bottom: var(--space-8);
      border-bottom: 1px solid var(--color-border);
    }

    .dash-welcome__greeting {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      font-weight: var(--weight-normal);
    }

    .dash-welcome__title {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      font-weight: var(--weight-bold);
      color: var(--color-text);
      line-height: 1.15;
    }

    .dash-welcome__title span {
      color: var(--color-gold);
    }

    .dash-welcome__sub {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      margin: 0;
      margin-top: var(--space-1);
    }

    /* ── Sección módulos ── */
    .dash-section__label {
      font-size: var(--text-xs);
      font-family: var(--font-display);
      font-weight: var(--weight-semi);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text-faint);
      margin-bottom: var(--space-5);
    }

    /* ── Grid de módulos ── */
    .modules-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }

    /* ── Card de módulo ── */
    .module-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      padding: var(--space-6);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      text-decoration: none;
      cursor: pointer;
      overflow: hidden;
      transition:
        border-color var(--transition-base),
        box-shadow   var(--transition-base),
        transform    var(--transition-fast);
    }

    .module-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% 0%,
        rgba(212,168,30,.07) 0%, transparent 70%);
      opacity: 0;
      transition: opacity var(--transition-base);
    }

    .module-card:hover {
      border-color: var(--color-gold);
      box-shadow: var(--shadow-gold);
      transform: translateY(-3px);
    }

    .module-card:hover::before { opacity: 1; }
    .module-card:active { transform: scale(0.98) translateY(0); }

    /* Card deshabilitada */
    .module-card--disabled {
      opacity: 0.45;
      cursor: not-allowed;
      pointer-events: none;
    }

    /* Ícono del módulo */
    .module-card__icon {
      width: 52px;
      height: 52px;
      border-radius: var(--radius-md);
      background: var(--color-gold-muted);
      border: 1px solid var(--color-border-gold);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-gold);
      transition: background var(--transition-base);
    }

    .module-card:hover .module-card__icon {
      background: rgba(212,168,30,0.22);
    }

    /* Textos */
    .module-card__body {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      flex: 1;
    }

    .module-card__title {
      font-family: var(--font-display);
      font-size: var(--text-md);
      font-weight: var(--weight-semi);
      color: var(--color-text);
      line-height: 1.25;
    }

    .module-card__desc {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      line-height: 1.55;
      margin: 0;
    }

    /* Footer de la card */
    .module-card__footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: var(--space-4);
      border-top: 1px solid var(--color-border);
    }

    .module-card__cta {
      font-size: var(--text-xs);
      font-family: var(--font-display);
      font-weight: var(--weight-semi);
      color: var(--color-gold);
      letter-spacing: 0.03em;
    }

    .module-card--disabled .module-card__cta {
      color: var(--color-text-faint);
    }

    .module-card__arrow {
      color: var(--color-text-faint);
      transition: color var(--transition-fast), transform var(--transition-fast);
    }

    .module-card:hover .module-card__arrow {
      color: var(--color-gold);
      transform: translateX(4px);
    }

    /* Badge "Próximamente" */
    .module-card__badge {
      position: absolute;
      top: var(--space-4);
      right: var(--space-4);
      padding: 3px var(--space-3);
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-full);
      font-size: 10px;
      font-family: var(--font-display);
      font-weight: var(--weight-semi);
      color: var(--color-text-faint);
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    /* ── Stats rápidas ── */
    .dash-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }

    .stat-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: var(--space-5) var(--space-6);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .stat-card__label {
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      font-family: var(--font-display);
      font-weight: var(--weight-medium);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .stat-card__value {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      font-weight: var(--weight-bold);
      color: var(--color-text);
      line-height: 1;
    }

    .stat-card__value--gold  { color: var(--color-gold); }
    .stat-card__value--green { color: var(--color-success); }

    .stat-card__sub {
      font-size: var(--text-xs);
      color: var(--color-text-faint);
    }

    /* ── Footer ── */
    .dash-footer {
      text-align: center;
      padding: var(--space-6) var(--space-8);
      border-top: 1px solid var(--color-border);
      font-size: var(--text-xs);
      color: var(--color-text-faint);
    }

    /* ── Responsive ── */
    @media (max-width: 900px) {
      .modules-grid { grid-template-columns: 1fr; }
      .dash-stats   { grid-template-columns: repeat(2, 1fr); }
      .dash-content { padding: var(--space-8) var(--space-4); }
      .dash-topbar  { padding: var(--space-4); }
    }

    @media (max-width: 560px) {
      .dash-stats { grid-template-columns: 1fr; }
      .dash-topbar__username { display: none; }
      .dash-topbar__role     { display: none; }
    }
  </style>
</head>
<body>

<div class="dashboard-page">

  <!-- ── Topbar ────────────────────────────────────────────────────────────── -->
  <header class="dash-topbar">
    <div class="dash-topbar__brand">
      <div class="dash-topbar__logo">FD</div>
      <div>
        <div class="dash-topbar__name">Fumi Dorado S.A.S</div>
        <div class="dash-topbar__sub">Sistema de gestión de servicios</div>
      </div>
    </div>

    <div class="dash-topbar__right">
      <div class="dash-topbar__user">
        <div class="dash-topbar__avatar">
          <%= currentUser.nombre.split(' ').map(n => n[0]).join('').slice(0,2).toUpperCase() %>
        </div>
        <div>
          <div class="dash-topbar__username"><%= currentUser.nombre %></div>
          <div class="dash-topbar__role">Administrador</div>
        </div>
      </div>
      <a href="/auth/logout" class="dash-topbar__logout">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <polyline points="16 17 21 12 16 7"/>
          <line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
        Cerrar sesión
      </a>
    </div>
  </header>

  <!-- ── Contenido ─────────────────────────────────────────────────────────── -->
  <main class="dash-content">

    <!-- Bienvenida -->
    <section class="dash-welcome">
      <span class="dash-welcome__greeting">
        <%= new Date().getHours() < 12 ? 'Buenos días' : new Date().getHours() < 18 ? 'Buenas tardes' : 'Buenas noches' %>,
      </span>
      <h1 class="dash-welcome__title">
        <%= currentUser.nombre.split(' ')[0] %> <span>👋</span>
      </h1>
      <p class="dash-welcome__sub">
        Panel de administración · <%= new Date().toLocaleDateString('es-CO', { weekday:'long', year:'numeric', month:'long', day:'numeric' }) %>
      </p>
    </section>

    <!-- Stats rápidas -->
    <div class="dash-stats">
      <div class="stat-card">
        <span class="stat-card__label">Técnicos activos</span>
        <span class="stat-card__value stat-card__value--gold"><%= stats.tecnicosActivos %></span>
        <span class="stat-card__sub">registrados en el sistema</span>
      </div>
      <div class="stat-card">
        <span class="stat-card__label">Administradores</span>
        <span class="stat-card__value"><%= stats.admins %></span>
        <span class="stat-card__sub">con acceso al panel</span>
      </div>
      <div class="stat-card">
        <span class="stat-card__label">Diagramas UPC</span>
        <span class="stat-card__value stat-card__value--green"><%= stats.diagramas %></span>
        <span class="stat-card__sub">subidos al sistema</span>
      </div>
    </div>

    <!-- Módulos -->
    <section>
      <p class="dash-section__label">Módulos disponibles</p>
      <div class="modules-grid">

        <!-- Gestión de usuarios -->
        <a href="/admin/usuarios" class="module-card">
          <div class="module-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.6">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <div class="module-card__body">
            <span class="module-card__title">Gestión de usuarios</span>
            <p class="module-card__desc">
              Administra técnicos y administradores. Crea, edita o elimina cuentas
              y gestiona los permisos de acceso al sistema.
            </p>
          </div>
          <div class="module-card__footer">
            <span class="module-card__cta">Ir al módulo</span>
            <svg class="module-card__arrow" width="16" height="16" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </div>
        </a>

        <!-- Diagramas UPC -->
        <a href="/admin/diagramas-upc" class="module-card">
          <div class="module-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.6">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
              <polyline points="10 9 9 9 8 9"/>
            </svg>
          </div>
          <div class="module-card__body">
            <span class="module-card__title">Diagramas UPC</span>
            <p class="module-card__desc">
              Sube y gestiona los diagramas de Ubicación de Puntos de Control
              en formato PDF, asociados a cada cliente y sede.
            </p>
          </div>
          <div class="module-card__footer">
            <span class="module-card__cta">Ir al módulo</span>
            <svg class="module-card__arrow" width="16" height="16" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </div>
        </a>

        <!-- Creada -->
        <a href="/admin/reportes" class="module-card">
          <span class="module-card__badge">RP</span>
          <div class="module-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.6">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
          </div>
          <div class="module-card__body">
            <span class="module-card__title">Reportes y consumo</span>
            <p class="module-card__desc">
              Visualiza el historial de visitas, mapas de calor de consumo
              y genera reportes por cliente o sede.
            </p>
          </div>
          <div class="module-card__footer">
            <span class="module-card__cta">Abrir modulo</span>
            <svg class="module-card__arrow" width="16" height="16" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </div>
        </a>

      </div>
    </section>

  </main>

  <!-- ── Footer ────────────────────────────────────────────────────────────── -->
  <footer class="dash-footer">
    © <%= new Date().getFullYear() %> FumiDorado S.A.S. · Todos los derechos reservados.
  </footer>

</div>

</body>
</html>
