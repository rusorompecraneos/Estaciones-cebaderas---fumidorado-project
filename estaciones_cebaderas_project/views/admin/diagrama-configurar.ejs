<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css"/>
  <!-- PDF.js para renderizar el PDF -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <style>
    * { box-sizing:border-box; margin:0; padding:0; }
    body { background:var(--color-bg); color:var(--color-text); font-family:var(--font-body); min-height:100vh; display:flex; flex-direction:column; }

    /* ── Topbar ── */
    .topbar {
      display:flex; align-items:center; justify-content:space-between;
      padding:var(--space-4) var(--space-6);
      background:var(--color-surface); border-bottom:1px solid var(--color-border);
      position:sticky; top:0; z-index:100; flex-shrink:0;
    }
    .topbar__left  { display:flex; align-items:center; gap:var(--space-4); }
    .topbar__back  { display:flex; align-items:center; gap:var(--space-2); color:var(--color-text-muted); text-decoration:none; transition:color var(--transition-fast); }
    .topbar__back:hover { color:var(--color-gold); }
    .topbar__title { font-family:var(--font-display); font-size:var(--text-md); font-weight:var(--weight-semi); line-height:1.2; }
    .topbar__sub   { font-size:var(--text-xs); color:var(--color-text-muted); }
    .topbar__right { display:flex; align-items:center; gap:var(--space-3); }
    .save-indicator { font-size:var(--text-xs); color:var(--color-text-faint); display:flex; align-items:center; gap:4px; }
    .save-indicator.saved   { color:var(--color-success); }
    .save-indicator.saving  { color:var(--color-warning); }

    /* ── Layout ── */
    .layout { flex:1; display:flex; overflow:hidden; }

    /* ── Panel izquierdo — toolbar ── */
    .toolbar {
      width:260px; flex-shrink:0;
      background:var(--color-surface); border-right:1px solid var(--color-border);
      display:flex; flex-direction:column; overflow-y:auto;
      padding:var(--space-5);
      gap:var(--space-5);
    }

    .toolbar__section-title {
      font-family:var(--font-display); font-size:var(--text-xs);
      font-weight:var(--weight-semi); letter-spacing:.08em;
      text-transform:uppercase; color:var(--color-text-faint);
      margin-bottom:var(--space-2);
    }

    /* Tipo de punto para agregar */
    .tipo-btn {
      display:flex; align-items:center; gap:var(--space-3);
      padding:var(--space-3) var(--space-4);
      border-radius:var(--radius-md);
      border:1.5px solid var(--color-border);
      background:var(--color-surface-2);
      cursor:pointer; transition:all var(--transition-fast);
      width:100%; text-align:left;
    }
    .tipo-btn:hover    { border-color:var(--color-gold); }
    .tipo-btn.selected { border-color:var(--color-gold); background:var(--color-gold-muted); }
    .tipo-btn__dot {
      width:12px; height:12px; border-radius:50%; flex-shrink:0;
    }
    .tipo-btn__label { font-size:var(--text-sm); color:var(--color-text); }

    /* Lista de puntos agregados */
    .puntos-list { display:flex; flex-direction:column; gap:var(--space-2); }
    .punto-item {
      display:flex; align-items:center; gap:var(--space-2);
      padding:var(--space-2) var(--space-3);
      background:var(--color-surface-2);
      border:1px solid var(--color-border);
      border-radius:var(--radius-md);
      font-size:var(--text-xs); color:var(--color-text-muted);
    }
    .punto-item__dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
    .punto-item__num { font-weight:var(--weight-semi); color:var(--color-text); }
    .punto-item__del {
      margin-left:auto; background:none; border:none;
      cursor:pointer; color:var(--color-text-faint);
      font-size:12px; padding:2px 4px;
      transition:color var(--transition-fast);
    }
    .punto-item__del:hover { color:var(--color-error); }

    /* Instrucciones */
    .instruccion {
      background:var(--color-gold-muted); border:1px solid var(--color-border-gold);
      border-radius:var(--radius-md); padding:var(--space-3) var(--space-4);
      font-size:var(--text-xs); color:var(--color-text-muted); line-height:1.6;
    }
    .instruccion strong { color:var(--color-gold); display:block; margin-bottom:4px; }

    /* ── Área del mapa ── */
    .map-area {
      flex:1; overflow:auto;
      background:#1a1a18;
      display:flex; align-items:flex-start; justify-content:center;
      padding:var(--space-6);
    }

    .map-wrap {
      position:relative;
      display:inline-block;
      box-shadow:var(--shadow-lg);
      cursor:crosshair;
    }

    #pdf-canvas { display:block; }

    /* Puntos sobre el PDF */
    .mapa-punto {
      position:absolute;
      width:28px; height:28px;
      border-radius:50%;
      border:2.5px solid white;
      display:flex; align-items:center; justify-content:center;
      font-size:10px; font-weight:700; color:white;
      transform:translate(-50%, -50%);
      cursor:move;
      user-select:none;
      box-shadow:0 2px 8px rgba(0,0,0,.4);
      transition:box-shadow var(--transition-fast), transform var(--transition-fast);
      z-index:10;
    }
    .mapa-punto:hover { box-shadow:0 0 0 3px rgba(255,255,255,.3); transform:translate(-50%,-50%) scale(1.15); }
    .mapa-punto.dragging { opacity:.85; transform:translate(-50%,-50%) scale(1.2); z-index:20; }

    /* Colores por tipo */
    .dot-quimica   { background:#C9962A; }
    .dot-mecanica  { background:#4FA3E0; }
    .dot-ecologica { background:#3B9B5C; }

    /* Loading PDF */
    .pdf-loading {
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      gap:var(--space-4); padding:var(--space-12);
      color:var(--color-text-muted); font-size:var(--text-sm);
    }
    .pdf-spinner {
      width:32px; height:32px;
      border:3px solid var(--color-border);
      border-top-color:var(--color-gold);
      border-radius:50%;
      animation:spin .8s linear infinite;
    }
    @keyframes spin { to { transform:rotate(360deg); } }
  </style>
</head>
<body>

<!-- Topbar -->
<header class="topbar">
  <div class="topbar__left">
    <a href="/admin/diagramas-upc" class="topbar__back">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </a>
    <div>
      <div class="topbar__title"><%= diagrama.nombre %></div>
      <div class="topbar__sub">
        <%= diagrama.cliente_codigo %> — <%= diagrama.cliente_nombre %> &nbsp;·&nbsp;
        Sede <%= diagrama.sede_codigo %> · <%= diagrama.sede_nombre %>
      </div>
    </div>
  </div>
  <div class="topbar__right">
    <span class="save-indicator" id="save-indicator"></span>
    <button class="btn btn--primary btn--sm" id="btn-guardar" type="button">
      Guardar configuración
    </button>
  </div>
</header>

<div class="layout">

  <!-- ── Toolbar izquierda ── -->
  <aside class="toolbar">

    <div>
      <div class="toolbar__section-title">1. Selecciona tipo</div>
      <div style="display:flex; flex-direction:column; gap:var(--space-2);">
        <% tipos.forEach(t => { %>
          <button class="tipo-btn" data-tipo="<%= t.value %>">
            <div class="tipo-btn__dot dot-<%= t.value %>"></div>
            <span class="tipo-btn__label"><%= t.label %></span>
          </button>
        <% }) %>
      </div>
    </div>

    <div class="instruccion">
      <strong>¿Cómo usar?</strong>
      1. Selecciona el tipo de estación arriba.<br/>
      2. Haz clic sobre el símbolo en el plano.<br/>
      3. Arrastra los puntos para ajustar.<br/>
      4. Guarda cuando termines.
    </div>

    <div>
      <div class="toolbar__section-title">Puntos agregados (<span id="count">0</span>)</div>
      <div class="puntos-list" id="puntos-list"></div>
    </div>

    <button class="btn btn--ghost btn--sm" id="btn-limpiar" type="button" style="margin-top:auto;">
      Limpiar todo
    </button>

  </aside>

  <!-- ── Área del PDF ── -->
  <div class="map-area">
    <div class="map-wrap" id="map-wrap">
      <div class="pdf-loading" id="pdf-loading">
        <div class="pdf-spinner"></div>
        <span>Cargando diagrama...</span>
      </div>
      <canvas id="pdf-canvas"></canvas>
    </div>
  </div>

</div>

<script>
// ── Config ────────────────────────────────────────────────────────────────────
const DIAGRAMA_ID  = '<%= diagrama.id %>';
const PDF_URL      = '/admin/diagramas-upc/<%= diagrama.id %>/pdf';
const TIPOS_CONFIG = {
  quimica:   { label: 'Química',   color: '#C9962A' },
  mecanica:  { label: 'Mecánica',  color: '#4FA3E0' },
  ecologica: { label: 'Ecológica', color: '#3B9B5C' },
};

// Puntos existentes desde servidor
const PUNTOS_INICIALES = <%- JSON.stringify(puntos) %>;

// ── Estado ────────────────────────────────────────────────────────────────────
let tipoSeleccionado = 'quimica';
let puntos = [];    // { id (temporal), numero, tipo, x_pct, y_pct }
let nextNum = 1;

// ── PDF.js ────────────────────────────────────────────────────────────────────
pdfjsLib.GlobalWorkerOptions.workerSrc =
  'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

const canvas  = document.getElementById('pdf-canvas');
const ctx     = canvas.getContext('2d');
const mapWrap = document.getElementById('map-wrap');

async function loadPDF() {
  const pdf  = await pdfjsLib.getDocument(PDF_URL).promise;
  const page = await pdf.getPage(1);

  const viewport = page.getViewport({ scale: 1.5 });
  canvas.width   = viewport.width;
  canvas.height  = viewport.height;

  await page.render({ canvasContext: ctx, viewport }).promise;

  document.getElementById('pdf-loading').style.display = 'none';
  canvas.style.display = 'block';

  // Cargar puntos existentes
  PUNTOS_INICIALES.forEach(p => addPunto(p.tipo, p.x_pct, p.y_pct, p.numero));
}

loadPDF();

// ── Selección de tipo ─────────────────────────────────────────────────────────
document.querySelectorAll('.tipo-btn').forEach(btn => {
  btn.addEventListener('click', function () {
    document.querySelectorAll('.tipo-btn').forEach(b => b.classList.remove('selected'));
    this.classList.add('selected');
    tipoSeleccionado = this.dataset.tipo;
  });
});
document.querySelector('.tipo-btn').classList.add('selected'); // seleccionar primero

// ── Click en mapa → agregar punto ─────────────────────────────────────────────
mapWrap.addEventListener('click', function (e) {
  if (e.target.closest('.mapa-punto')) return; // clic en punto existente, ignorar

  const rect = canvas.getBoundingClientRect();
  const x_pct = ((e.clientX - rect.left) / rect.width)  * 100;
  const y_pct = ((e.clientY - rect.top)  / rect.height) * 100;

  addPunto(tipoSeleccionado, x_pct, y_pct);
});

// ── Agregar punto ─────────────────────────────────────────────────────────────
function addPunto(tipo, x_pct, y_pct, numero = null) {
  const num = numero || nextNum++;
  if (!numero) nextNum = Math.max(nextNum, num + 1);

  const id = `p-${Date.now()}-${Math.random()}`;
  puntos.push({ id, numero: num, tipo, x_pct: Number(x_pct), y_pct: Number(y_pct) });

  // Crear elemento visual
  const dot = document.createElement('div');
  dot.className   = `mapa-punto dot-${tipo}`;
  dot.id          = id;
  dot.textContent = num;
  dot.style.left  = `${x_pct}%`;
  dot.style.top   = `${y_pct}%`;
  dot.title       = `E${num} — ${TIPOS_CONFIG[tipo].label}`;

  // Drag
  makeDraggable(dot, id);
  mapWrap.appendChild(dot);

  renderPuntosList();
}

// ── Arrastrar punto ───────────────────────────────────────────────────────────
function makeDraggable(el, id) {
  let startX, startY, startLeft, startTop;

  el.addEventListener('mousedown', function (e) {
    e.stopPropagation();
    el.classList.add('dragging');
    const rect = canvas.getBoundingClientRect();
    startX    = e.clientX;
    startY    = e.clientY;
    startLeft = parseFloat(el.style.left);
    startTop  = parseFloat(el.style.top);

    function onMove(e) {
      const dx = ((e.clientX - startX) / rect.width)  * 100;
      const dy = ((e.clientY - startY) / rect.height) * 100;

      const newX = Math.min(100, Math.max(0, startLeft + dx));
      const newY = Math.min(100, Math.max(0, startTop  + dy));

      el.style.left = `${newX}%`;
      el.style.top  = `${newY}%`;

      const p = puntos.find(p => p.id === id);
      if (p) { p.x_pct = newX; p.y_pct = newY; }
    }

    function onUp() {
      el.classList.remove('dragging');
      document.removeEventListener('mousemove', onMove);
      document.removeEventListener('mouseup',   onUp);
    }

    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup',   onUp);
  });
}

// ── Eliminar punto ────────────────────────────────────────────────────────────
function deletePunto(id) {
  puntos = puntos.filter(p => p.id !== id);
  document.getElementById(id)?.remove();
  renderPuntosList();
}

// ── Lista de puntos en sidebar ────────────────────────────────────────────────
function renderPuntosList() {
  const list = document.getElementById('puntos-list');
  document.getElementById('count').textContent = puntos.length;

  list.innerHTML = puntos.length === 0
    ? '<span style="font-size:var(--text-xs);color:var(--color-text-faint);">Aún no hay puntos.</span>'
    : '';

  puntos.forEach(p => {
    const item = document.createElement('div');
    item.className = 'punto-item';
    item.innerHTML = `
      <div class="punto-item__dot" style="background:${TIPOS_CONFIG[p.tipo].color};"></div>
      <span class="punto-item__num">E${p.numero}</span>
      <span style="flex:1;">${TIPOS_CONFIG[p.tipo].label}</span>
      <button class="punto-item__del" onclick="deletePunto('${p.id}')">✕</button>`;
    list.appendChild(item);
  });
}

// ── Limpiar todo ──────────────────────────────────────────────────────────────
document.getElementById('btn-limpiar').addEventListener('click', function () {
  if (!confirm('¿Eliminar todos los puntos?')) return;
  puntos = [];
  nextNum = 1;
  document.querySelectorAll('.mapa-punto').forEach(el => el.remove());
  renderPuntosList();
});

// ── Guardar ───────────────────────────────────────────────────────────────────
const saveIndicator = document.getElementById('save-indicator');

document.getElementById('btn-guardar').addEventListener('click', async function () {
  if (puntos.length === 0) {
    alert('Agrega al menos un punto antes de guardar.');
    return;
  }

  this.disabled = true;
  saveIndicator.className = 'save-indicator saving';
  saveIndicator.textContent = 'Guardando...';

  const payload = puntos.map((p, i) => ({
    numero: i + 1,
    tipo:   p.tipo,
    x_pct:  parseFloat(p.x_pct.toFixed(3)),
    y_pct:  parseFloat(p.y_pct.toFixed(3)),
  }));

  try {
    const res  = await fetch(`/admin/diagramas-upc/${DIAGRAMA_ID}/puntos`, {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify({ puntos: payload }),
    });
    const data = await res.json();

    if (data.success) {
      saveIndicator.className = 'save-indicator saved';
      saveIndicator.textContent = `✓ ${data.total} puntos guardados`;
      setTimeout(() => { saveIndicator.textContent = ''; saveIndicator.className = 'save-indicator'; }, 3000);
    } else {
      saveIndicator.textContent = '✗ Error al guardar';
      saveIndicator.className   = 'save-indicator';
      alert(data.message || 'Error al guardar.');
    }
  } catch {
    saveIndicator.textContent = '✗ Error de conexión';
    alert('Error de conexión.');
  } finally {
    this.disabled = false;
  }
});

renderPuntosList();
</script>

</body>
</html>
